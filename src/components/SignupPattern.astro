---
/**
 * The three tonal metaballs in the corners of every sign-up card (design
 * `.ob-sf__pat--a|b|c`). Inlined through the import, like the home hero's, so
 * the path's `currentColor` takes the token tint the class sets; purely
 * decorative, so hidden from assistive tech.
 */
import Metaball from '@/assets/metaball-element.svg';
---

<Metaball class="ob-signup__pat ob-signup__pat--a" aria-hidden="true" />
<Metaball class="ob-signup__pat ob-signup__pat--b" aria-hidden="true" />
<Metaball class="ob-signup__pat ob-signup__pat--c" aria-hidden="true" />
