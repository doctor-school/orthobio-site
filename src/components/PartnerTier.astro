---
/**
 * PartnerTier — one tier of partners/organizers (bundle
 * components/partners/PartnerTier).
 *
 * Logo and text cards are BOTH finished states, and the grid mixes them on
 * purpose. Since Issue #22 the 84 partners whose mark survives on a source
 * site render their logo; the remaining 19 have no mark anywhere and keep the
 * text card — which is why the text branch is not a loading fallback and must
 * not be styled as a degraded one.
 *
 * Major tiers (organizers / strategic / general) get the larger card grid.
 *
 * Every tier opens with a COLOURED DOT (`.ob-pt__dot`), the bundle's own
 * hierarchy marker — restored in Issue #27 after the design port dropped it.
 * Two deliberate departures from how the bundle's JSX writes it:
 *
 * • the colour comes from a per-tier CLASS, not an inline `style` — the
 *   tier→token map belongs in components.css (AGENTS.md → Code style forbids
 *   inline `style=`) and is pinned in tests/unit/partner-tier-markers.test.ts;
 * • the dot lives INSIDE the heading, where the bundle makes it a flex sibling
 *   of it. As a sibling it is a flex item of `.ob-pt__h`, and that row wraps
 *   (long labels): measured at 360px on /partners, «Информационные партнёры ·
 *   2026» pushed the heading to the next flex line and left the marker
 *   stranded on a line of its own. Inline in the heading it rides the first
 *   line of the text and cannot be separated from it at any width.
 *
 * The dot is decoration — the tier is spelled out in the heading it sits in —
 * so it is `aria-hidden`, which also keeps it out of the heading's accessible
 * name (AccName §4.1 excludes hidden nodes).
 *
 * Since Issue #24 a card is also the way INTO a partner's profile page: where
 * the roster entry carries a `slug`, the card links to `/partners/<slug>/`
 * rather than to the company's own website (`partnerCardHref`). That keeps the
 * card a SINGLE link — a «Подробнее» anchor added next to a card that is
 * already an `<a>` would have been a nested link, which is invalid HTML and
 * unreachable by keyboard.
 *
 * The logo slot is 120×72, declared in CSS (.ob-pt__card img, `object-fit:
 * contain`) and repeated as width/height on both <img> below: the schema
 * carries no logo dimensions and the marks are fetched from S3, so the
 * reserved box is what keeps the grid from reflowing while they lazy-load.
 * Both branches render the same <img> — only the wrapper differs (<a> for a
 * partner with a url, <span> without) — so the contract is stated here once
 * rather than twice inside the markup. Its values are pinned in
 * tests/unit/partner-logos.test.ts.
 */
import { mediaUrl } from '@/config/site';
import type { CongressEntry, PartnerTier } from '@/content';
import { MAJOR_TIERS } from '@/lib/congress';
import { partnerCardHref } from '@/lib/partners';

interface Props {
  tier: PartnerTier;
  label: string;
  partners: CongressEntry['data']['partners'];
  /** Heading level — h3 inside a section, h2 when the tier IS the section. */
  level?: 'h2' | 'h3';
  /**
   * Year appended to the tier heading. Needed where the page is ABOUT another
   * year than the roster: on /partners the same five level names are offered as
   * the 2027 structure right above the 2026 registry, so bare «Генеральные
   * партнёры» read as slots already taken (content audit К1). On
   * /archive/<year> the whole page is the year — passing it there would only
   * repeat the h1.
   */
  year?: number | null;
}

const { tier, label, partners, level = 'h3', year = null } = Astro.props;
const cls = `ob-pt ob-pt--${MAJOR_TIERS.includes(tier) ? 'major' : 'minor'}`;
// Part of the heading TEXT, not a decoration beside it: the qualifier has to
// reach anyone navigating by headings, which is exactly the reader the finding
// is about.
const heading = year ? `${label} · ${year}` : label;

/**
 * «External» means ANOTHER ORIGIN, not «starts with http».
 *
 * МОО «ОРТО»'s own site IS this domain — `2025.yaml` carries
 * `url: https://orthobio.ru/`, faithful to the recon — so a blanket `target`
 * opened a second tab of the page the reader was already standing on. The
 * comparison runs against `Astro.site` (the canonical origin in
 * astro.config.mjs) rather than a hardcoded host, so it stays correct when the
 * partner registry is edited or the apex finally points here.
 */
const siteOrigin = Astro.site?.origin;
const isExternal = (url: string): boolean => {
  // Without a configured `site` nothing can be proven external; staying in the
  // current tab is the recoverable failure, a stray tab is not.
  if (!siteOrigin) return false;
  try {
    return new URL(url, siteOrigin).origin !== siteOrigin;
  } catch {
    return false;
  }
};

/** New-tab attributes for a link that leaves the site; nothing for one that stays. */
const newTab = (url: string): Record<string, string> =>
  isExternal(url) ? { target: '_blank', rel: 'noopener' } : {};
---

{
  partners.length > 0 && (
    <div class={cls}>
      <div class="ob-pt__h">
        {level === 'h2' ? (
          <h2 class="ob-pt__title">
            <span class={`ob-pt__dot ob-pt__dot--${tier}`} aria-hidden="true" />
            {heading}
          </h2>
        ) : (
          <h3 class="ob-pt__title">
            <span class={`ob-pt__dot ob-pt__dot--${tier}`} aria-hidden="true" />
            {heading}
          </h3>
        )}
        <span class="ob-pt__count">{partners.length}</span>
      </div>
      <div class="ob-pt__grid">
        {partners.map((p) => {
          /* A profile page wins over the partner's own website (Issue #24):
             the card opens what WE can show, and the external site is offered
             from inside the profile. `newTab` then correctly resolves an
             internal profile href to «same tab». */
          const href = partnerCardHref(p);
          const isProfile = p.slug !== null;
          return href ? (
            <a
              class={`ob-pt__card${isProfile ? ' ob-pt__card--profile' : ''}`}
              href={href}
              {...newTab(href)}
            >
              {
                p.logo ? (
                  <img src={mediaUrl(p.logo)} alt={p.name} width="120" height="72" loading="lazy" />
                ) : (
                  p.name
                )
              }
              {/* The visible affordance the AC asks for, INSIDE the single <a>:
                  a profile card and an external-site card were pixel-identical,
                  so nothing told the reader that one keeps them on this site and
                  the other leaves it. It also gives the link a fuller accessible
                  name — «<Название> Подробнее →», since pseudo-element content
                  counts towards it (AccName §2F, as measured for .ob-arrow). */}
              {isProfile && <span class="ob-pt__more">Подробнее</span>}
            </a>
          ) : (
            /* A partner with neither a profile nor a `url` is a plain roster
               entry. It must not LOOK like the linked cards beside it:
               `--static` drops the card fill and the pointer affordances (see
               components.css). */
            <span class="ob-pt__card ob-pt__card--static">
              {
                p.logo ? (
                  <img src={mediaUrl(p.logo)} alt={p.name} width="120" height="72" loading="lazy" />
                ) : (
                  p.name
                )
              }
            </span>
          );
        })}
      </div>
    </div>
  )
}
