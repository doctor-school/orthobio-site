---
/**
 * PhotoGrid — фотоотчёт года (bundle components/archive/PhotoGrid v2).
 *
 * Three things beyond a plain grid, all of them pure CSS/HTML (the site ships
 * zero client JS — AGENTS.md):
 * • reportage grid: the first photo occupies a 2×2 cell from 640px up;
 * • everything past `visible` hides inside a native <details>, so a year with
 *   80 photos does not bury the sections under it;
 * • click-to-enlarge is a `:target` lightbox — each photo has a full-screen
 *   `<div id>` that the tile links to, with ←/→ links cycling through the set
 *   and the backdrop/✕ linking back to the grid anchor.
 *
 * The originals in the bucket are camera JPEGs up to 5811px wide, so `<Image>`
 * resizes them at BUILD time and emits a `srcset`: a tile and a lightbox frame
 * are separate size ladders, and a phone on mobile data never downloads a 3MB
 * original. The intrinsic ratio comes from the content model (the schema
 * requires width/height), which is what reserves layout space and keeps CLS at
 * zero; `displaySize()` caps the largest variant we ask sharp to produce.
 */
import { Image } from 'astro:assets';

import { mediaUrl } from '@/config/site';
import type { CongressEntry } from '@/content';
import { displaySize } from '@/lib/congress';

interface Props {
  photos: CongressEntry['data']['photos'];
  year: number;
  /** Tiles shown before the «Показать все фото» disclosure. */
  visible?: number;
  /** Anchor base — only needed if a page ever renders two galleries. */
  id?: string;
}

const { photos, year, visible = 11, id } = Astro.props;

const base = id ?? `pg${year}`;
const head = photos.slice(0, visible);
const rest = photos.slice(visible);

/** Tile widths across the ladder: two columns at 360 → four at 1280. */
const TILE_WIDTHS = [320, 480, 640];
const TILE_MAX = 640;
const TILE_SIZES = '(min-width: 1024px) 300px, (min-width: 640px) 33vw, 46vw';

/** Lightbox frame: capped at the design's `max-width: min(1100px, 94vw)`. */
const FRAME_WIDTHS = [640, 1100];
const FRAME_MAX = 1100;
const FRAME_SIZES = '(min-width: 1170px) 1100px, 94vw';

const altOf = (
  photo: CongressEntry['data']['photos'][number],
  index: number,
): string => photo.alt ?? `Конгресс ОРТОБИОЛОГИЯ ${year}, фото ${index + 1}`;
---

{
  photos.length > 0 && (
    <div class="ob-pg" id={base}>
      <div class="ob-pg__grid ob-pg__grid--lead">
        {head.map((p, i) => {
          const size = displaySize(p.width, p.height, TILE_MAX);
          return (
            <a class="ob-pg__it" href={`#${base}-${i + 1}`}>
              <Image
                src={mediaUrl(p.url)}
                alt={altOf(p, i)}
                width={size.width}
                height={size.height}
                widths={TILE_WIDTHS}
                sizes={TILE_SIZES}
                loading="lazy"
                decoding="async"
              />
            </a>
          );
        })}
      </div>

      {rest.length > 0 && (
        <details class="ob-pg__more">
          <summary>
            <span class="ob-pg__sum-show">Показать все фото ({photos.length})</span>
            <span class="ob-pg__sum-hide">Свернуть фотоотчёт</span>
          </summary>
          <div class="ob-pg__grid">
            {rest.map((p, i) => {
              const index = i + visible;
              const size = displaySize(p.width, p.height, TILE_MAX);
              return (
                <a class="ob-pg__it" href={`#${base}-${index + 1}`}>
                  <Image
                    src={mediaUrl(p.url)}
                    alt={altOf(p, index)}
                    width={size.width}
                    height={size.height}
                    widths={TILE_WIDTHS}
                    sizes={TILE_SIZES}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              );
            })}
          </div>
        </details>
      )}

      {photos.map((p, i) => {
        const prev = ((i - 1 + photos.length) % photos.length) + 1;
        const next = ((i + 1) % photos.length) + 1;
        const size = displaySize(p.width, p.height, FRAME_MAX);
        return (
          <div class="ob-pg__lb" id={`${base}-${i + 1}`} role="dialog" aria-label={altOf(p, i)}>
            {/* Click-outside closes; kept out of the tab order because the ✕
                right next to it is the same action with a real label. */}
            <a class="ob-pg__bg" href={`#${base}`} aria-label="Закрыть" tabindex="-1" />
            <a class="ob-pg__close" href={`#${base}`} aria-label="Закрыть">
              ✕
            </a>
            <figure>
              <Image
                src={mediaUrl(p.url)}
                alt={altOf(p, i)}
                width={size.width}
                height={size.height}
                widths={FRAME_WIDTHS}
                sizes={FRAME_SIZES}
                loading="lazy"
                decoding="async"
              />
              <a class="ob-pg__nav ob-pg__nav--prev" href={`#${base}-${prev}`} aria-label="Предыдущее фото">
                ←
              </a>
              <a class="ob-pg__nav ob-pg__nav--next" href={`#${base}-${next}`} aria-label="Следующее фото">
                →
              </a>
              <figcaption>
                <span>{altOf(p, i)}</span>
                <span>
                  {i + 1} / {photos.length}
                </span>
              </figcaption>
            </figure>
          </div>
        );
      })}
    </div>
  )
}
