---
/**
 * /contacts — ТЗ §4.
 *
 * ⚠️ The congress contact is undecided (CONTACT_EMAIL / CONTACT_PHONE are
 * TODO(Антон) in config/site.ts) and MUST NOT be welcome@congress-ph.ru — that
 * mailbox belongs to the 2026 site's technical operator. Until the owner
 * decides, the page says so through the `Stub` block: the prose alone read as
 * an unfinished page rather than a declared state (content audit М3).
 *
 * One config value really does flip the whole page, and that costs a rule in
 * contacts.yaml: EVERY sentence about the address being undecided lives in the
 * `stub` block, which is what this file gates. The lead used to repeat the same
 * statement (the review of PR #17 caught it: `lead` is passed through
 * untouched), so filling CONTACT_EMAIL would have printed the real address under
 * a paragraph promising it later. The lead now says what the оргкомитет is FOR,
 * which stays true in both states.
 */
import SectionHeading from '@/components/SectionHeading.astro';
import { CONTACT_EMAIL, CONTACT_PHONE } from '@/config/site';
import { getPage } from '@/content';
import SectionLayout from '@/layouts/SectionLayout.astro';

const { data: page } = await getPage('contacts');
const hasContacts = CONTACT_EMAIL !== null || CONTACT_PHONE !== null;
const blocks = hasContacts ? page.blocks.filter((b) => b.kind !== 'stub') : page.blocks;
---

<SectionLayout page={{ ...page, blocks }}>
  {
    hasContacts && (
      <div class="ob-container ob-section">
        <SectionHeading title="Оргкомитет" />
        <ul class="ob-list">
          {CONTACT_EMAIL && (
            <li>
              <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            </li>
          )}
          {CONTACT_PHONE && (
            <li>
              <a href={`tel:${CONTACT_PHONE.replace(/[^+\d]/g, '')}`}>{CONTACT_PHONE}</a>
            </li>
          )}
        </ul>
      </div>
    )
  }
</SectionLayout>
