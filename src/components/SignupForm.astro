---
/**
 * SignupForm — the congress sign-up card of /registration (Issue #78; platform
 * 044). The page is static; this is the one place on the site where client JS
 * is genuinely required: the registration window is evaluated in the browser,
 * the specialty list is fetched live, and the submission is a same-origin JSON
 * POST that nginx proxies to the platform API (`/api/v1/…` → `/v1/…`).
 *
 * Every state block ships `hidden`; the script reveals exactly one. Without
 * scripting the `<noscript>` card asks for JavaScript in a date-neutral line —
 * it must stay true before, during and after the window — and no form is
 * shown, because this one only submits through the script.
 *
 * Client checks are a courtesy, the platform is the truth: the ФИО
 * normalisation on blur mirrors 044 EARS-33, the phone check mirrors EARS-29,
 * and a refusal from the API is always rendered, whatever the form thought.
 *
 * SmartCaptcha is invisible (Issue #81): no checkbox, the check runs on submit
 * and only a suspicious session gets a challenge pop-up. Preview and
 * production ship the same build, so both site keys are printed as data
 * attributes and the script picks one by hostname (`pickSitekey`,
 * lib/captcha.ts). With no key for the current host there is no widget, no
 * third-party script and no `captchaToken` in the request. The widget's own
 * data-processing shield stays visible (`hideShield` is left unset): Yandex
 * requires users to be told SmartCaptcha processes their data, and the shield
 * is that notice.
 *
 * Look (Issue #82, design SignupForm): a white card on a green panel with
 * tonal metaballs in its corners; the status cards are the same card with a
 * badge. Glyphs that script-written text would wipe (field errors, the alert)
 * are CSS masks, and the consent tick is drawn on the native checkbox, so the
 * selectors the script and the e2e suite rely on stay as they were.
 */
import Button from '@/components/Button.astro';
import SignupPattern from '@/components/SignupPattern.astro';
import StrokeIcon from '@/components/StrokeIcon.astro';
import {
  CONTACT_EMAIL,
  NOTIFY_CHANNEL_URL,
  NOTIFY_CTA_LABEL,
  REGISTRATION_WINDOW,
  SMARTCAPTCHA_SITEKEY,
  SMARTCAPTCHA_SITEKEY_PREVIEW,
  UPCOMING_CONGRESS_DATES,
} from '@/config/site';
import { FORCE_OPEN_HOSTS, formatMoscowInstant } from '@/lib/registration';

const opensLabel = formatMoscowInstant(REGISTRATION_WINDOW.opensAt);
const hasCaptchaKey = SMARTCAPTCHA_SITEKEY !== '' || SMARTCAPTCHA_SITEKEY_PREVIEW !== '';
const closesLabel = formatMoscowInstant(REGISTRATION_WINDOW.closesAt);
---

<div
  class="ob-signup"
  data-signup
  data-sitekey-prod={SMARTCAPTCHA_SITEKEY}
  data-sitekey-preview={SMARTCAPTCHA_SITEKEY_PREVIEW}
>
  <noscript>
    <div class="ob-signup__card ob-signup__card--status ob-signup__status">
      <SignupPattern />
      <h2 class="ob-signup__stitle">Регистрация на конгресс</h2>
      <p class="ob-signup__stext">Для регистрации включите JavaScript в браузере.</p>
    </div>
  </noscript>

  <div class="ob-signup__card" data-signup-state="open" hidden>
    <SignupPattern />
    <div class="ob-signup__head" data-signup-head>
      <h2 class="ob-signup__title" id="signup-title">Регистрация на конгресс</h2>
      <p class="ob-signup__sub">{UPCOMING_CONGRESS_DATES.display} года, Москва</p>
    </div>

    <!-- `method="post"` and the disabled button are a pair of belts for the
         moments before the module has attached its submit handler (the card
         is revealed before first paint, the module runs later — or never, if
         it fails to load). A disabled default button makes implicit
         submission (Enter) a no-op; POST keeps a native submit, should one
         ever happen, out of URLs, history and access logs. openForm() enables
         the button once the handler is in place. -->
    <form
      class="ob-signup__form"
      method="post"
      data-signup-form
      novalidate
      aria-labelledby="signup-title"
    >
      <div class="ob-signup__row ob-signup__row--3">
        <div class="ob-signup__field">
          <label class="ob-signup__label" for="signup-surname">Фамилия</label>
          <input
            class="ob-signup__input"
            id="signup-surname"
            name="surname"
            type="text"
            autocomplete="family-name"
            placeholder="Иванов"
            maxlength="200"
            required
            aria-required="true"
            aria-describedby="signup-surname-error"
            data-name-field
          />
          <div class="ob-signup__msgs">
            <p class="ob-signup__error" id="signup-surname-error" hidden></p>
          </div>
        </div>
        <div class="ob-signup__field">
          <label class="ob-signup__label" for="signup-first-name">Имя</label>
          <input
            class="ob-signup__input"
            id="signup-first-name"
            name="firstName"
            type="text"
            autocomplete="given-name"
            placeholder="Иван"
            maxlength="200"
            required
            aria-required="true"
            aria-describedby="signup-first-name-error"
            data-name-field
          />
          <div class="ob-signup__msgs">
            <p class="ob-signup__error" id="signup-first-name-error" hidden></p>
          </div>
        </div>
        <div class="ob-signup__field">
          <label class="ob-signup__label" for="signup-patronymic">
            Отчество <span class="ob-signup__optional">(если есть)</span>
          </label>
          <input
            class="ob-signup__input"
            id="signup-patronymic"
            name="patronymic"
            type="text"
            autocomplete="additional-name"
            placeholder="Иванович"
            maxlength="200"
            aria-describedby="signup-patronymic-error"
            data-name-field
          />
          <div class="ob-signup__msgs">
            <p class="ob-signup__error" id="signup-patronymic-error" hidden></p>
          </div>
        </div>
      </div>

      <div class="ob-signup__row ob-signup__row--2">
        <div class="ob-signup__field">
          <label class="ob-signup__label" for="signup-email">E-mail</label>
          <input
            class="ob-signup__input"
            id="signup-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder="name@example.com"
            maxlength="200"
            required
            aria-required="true"
            aria-describedby="signup-email-error"
          />
          <div class="ob-signup__msgs">
            <p class="ob-signup__error" id="signup-email-error" hidden></p>
          </div>
        </div>
        <div class="ob-signup__field">
          <label class="ob-signup__label" for="signup-phone">Телефон</label>
          <input
            class="ob-signup__input"
            id="signup-phone"
            name="contactPhone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            placeholder="+7 (999) 123-45-67"
            maxlength="200"
            required
            aria-required="true"
            aria-describedby="signup-phone-error"
          />
          <div class="ob-signup__msgs">
            <p class="ob-signup__error" id="signup-phone-error" hidden></p>
          </div>
        </div>
      </div>

      <div class="ob-signup__row">
        <div class="ob-signup__field">
          <label class="ob-signup__label" for="signup-workplace">Место работы</label>
          <input
            class="ob-signup__input"
            id="signup-workplace"
            name="workplace"
            type="text"
            autocomplete="organization"
            placeholder="Клиника или организация"
            maxlength="200"
            required
            aria-required="true"
            aria-describedby="signup-workplace-error"
          />
          <div class="ob-signup__msgs">
            <p class="ob-signup__error" id="signup-workplace-error" hidden></p>
          </div>
        </div>
      </div>

      <div class="ob-signup__row">
        <div class="ob-signup__field">
          <label class="ob-signup__label" for="signup-specialty">Специальность</label>
          <div class="ob-signup__combo">
            <input
              class="ob-signup__input"
              id="signup-specialty"
              type="text"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="signup-specialty-list"
              autocomplete="off"
              placeholder="Начните вводить"
              maxlength="200"
              required
              aria-required="true"
              aria-describedby="signup-specialty-hint signup-specialty-error"
            />
            <span class="ob-signup__chev" data-combo-open aria-hidden="true">
              <StrokeIcon name="chevron" />
            </span>
            <ul
              class="ob-signup__list"
              id="signup-specialty-list"
              role="listbox"
              aria-label="Список специальностей"
              hidden
            >
            </ul>
          </div>
          <input type="hidden" name="specialtyId" data-specialty-id />
          <div class="ob-signup__msgs">
            <p class="ob-signup__hint" id="signup-specialty-hint">
              Если вы не медицинский работник, выберите «Другое».
            </p>
            <p class="ob-signup__error" id="signup-specialty-error" hidden></p>
          </div>
        </div>
      </div>

      <div class="ob-signup__row ob-signup__row--2 ob-signup__row--place">
        <div class="ob-signup__field">
          <label class="ob-signup__label" for="signup-city">Населённый пункт</label>
          <div class="ob-signup__combo">
            <input
              class="ob-signup__input"
              id="signup-city"
              name="city"
              type="text"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="signup-city-list"
              autocomplete="off"
              placeholder="Например, Химки"
              maxlength="200"
              required
              aria-required="true"
              aria-describedby="signup-city-hint signup-city-error"
              data-settlement
            />
            <span class="ob-signup__chev" data-combo-open aria-hidden="true">
              <StrokeIcon name="chevron" />
            </span>
            <ul
              class="ob-signup__list"
              id="signup-city-list"
              role="listbox"
              aria-label="Список населённых пунктов"
              hidden
            >
            </ul>
          </div>
          <div class="ob-signup__msgs">
            <!-- The region of a directory entry (design: «Химки» in the field,
                 «Московская область» under it). -->
            <p class="ob-signup__hint" id="signup-city-hint" data-city-hint hidden></p>
            <p class="ob-signup__error" id="signup-city-error" hidden></p>
          </div>
        </div>
        <div class="ob-signup__field" data-region-field hidden>
          <label class="ob-signup__label" for="signup-region">Регион</label>
          <input
            class="ob-signup__input"
            id="signup-region"
            name="region"
            type="text"
            autocomplete="address-level1"
            placeholder="Область, край или страна"
            maxlength="200"
            required
            aria-required="true"
            aria-describedby="signup-region-hint signup-region-error"
          />
          <div class="ob-signup__msgs">
            <p class="ob-signup__hint" id="signup-region-hint" data-region-hint>
              Этого населённого пункта нет в&nbsp;списке&nbsp;— укажите регион или страну.
            </p>
            <p class="ob-signup__error" id="signup-region-error" hidden></p>
          </div>
        </div>
        <!-- Never hidden: a live region must exist before its text arrives. -->
        <p class="ob-sr-only" role="status" data-region-status></p>
      </div>

      <div class="ob-signup__row">
        <div class="ob-signup__field">
          <div class="ob-signup__consent">
            <input
              class="ob-signup__check"
              id="signup-consent"
              name="personalDataConsent"
              type="checkbox"
              required
              aria-required="true"
              aria-describedby="signup-consent-error"
            />
            <label class="ob-signup__consent-label" for="signup-consent">
              Я согласен(а) на обработку персональных данных в соответствии с <a href="/privacy"
                >политикой конфиденциальности</a
              >
            </label>
          </div>
          <div class="ob-signup__msgs">
            <p class="ob-signup__error" id="signup-consent-error" hidden></p>
          </div>
        </div>
      </div>

      <div class="ob-signup__actions">
        <p class="ob-signup__alert" data-signup-alert role="alert"></p>
        <button class="ob-btn ob-btn--accent ob-btn--lg ob-btn--block" type="submit" data-signup-submit disabled>
          Зарегистрироваться
        </button>
        {
          hasCaptchaKey && (
            <>
              <div class="ob-signup__captcha" data-captcha />
              <p class="ob-signup__captcha-note">Форма защищена Yandex SmartCaptcha</p>
            </>
          )
        }
      </div>
    </form>

    <!-- The heading takes the focus (design); its description carries the
         address, so one announcement holds both. -->
    <div class="ob-signup__success ob-signup__status" data-signup-success role="status" hidden>
      <span class="ob-signup__badge ob-signup__badge--ok" aria-hidden="true">
        <StrokeIcon name="check" />
      </span>
      <h2
        class="ob-signup__stitle"
        tabindex="-1"
        aria-describedby="signup-success-text"
        data-signup-success-text
      >
        Заявка принята
      </h2>
      <p class="ob-signup__stext" id="signup-success-text">
        Письмо-подтверждение придёт на <b data-signup-email></b> в&nbsp;течение нескольких минут. Если
        его нет&nbsp;— проверьте папку «Спам».
      </p>
    </div>
  </div>

  <div
    class="ob-signup__card ob-signup__card--status ob-signup__status"
    data-signup-state="not-yet-open"
    hidden
  >
    <SignupPattern />
    <span class="ob-signup__badge" aria-hidden="true">
      <StrokeIcon name="calendar" />
    </span>
    <h2 class="ob-signup__stitle" tabindex="-1">
      Регистрация откроется <span data-signup-opens-at>{opensLabel}</span>
    </h2>
    <p class="ob-signup__stext">
      Форма появится на этой странице в момент открытия регистрации. Конгресс пройдёт {
        UPCOMING_CONGRESS_DATES.display
      } года.
    </p>
    <Button variant="accent" size="lg" arrow href={NOTIFY_CHANNEL_URL} external>{NOTIFY_CTA_LABEL}</Button>
  </div>

  <div class="ob-signup__card ob-signup__card--status ob-signup__status" data-signup-state="closed" hidden>
    <SignupPattern />
    <span class="ob-signup__badge ob-signup__badge--neutral" aria-hidden="true">
      <StrokeIcon name="lock" />
    </span>
    <h2 class="ob-signup__stitle" tabindex="-1">Регистрация на конгресс закрыта</h2>
    <p class="ob-signup__stext">
      Приём заявок завершился {closesLabel}. Если вы зарегистрировались, письмо-подтверждение уже
      в&nbsp;вашей почте.
    </p>
    {
      CONTACT_EMAIL && (
        <p class="ob-signup__stext">
          По вопросам участия пишите на <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      )
    }
  </div>
</div>

<!--
  First-paint state (PR #87 audit: CLS 0.13–0.28). Every card ships `hidden`
  and the module below runs only after the first paint, so the form column
  used to open from zero height and push the venue card down. This parser-
  blocking snippet reveals the card the device clock predicts before anything
  is painted; the module then judges again (server clock included) and
  switches only if the answer differs. The rule is `registrationState` of
  lib/registration.ts restated in plain JS — an inline script cannot import —
  and its inputs come from the same constants, so only the three comparisons
  are duplicated; an e2e test runs this snippet alone (module blocked) at the
  boundary instants and holds it to `registrationState`'s answers.
  Without scripting nothing runs and only the <noscript> card shows, as before.
-->
<script
  is:inline
  define:vars={{
    opensAt: REGISTRATION_WINDOW.opensAt,
    closesAt: REGISTRATION_WINDOW.closesAt,
    forceOpenHosts: FORCE_OPEN_HOSTS,
  }}
>
  var signupRoot = document.querySelector('[data-signup]');
  if (signupRoot) {
    var now = Date.now();
    var state =
      forceOpenHosts.indexOf(location.hostname) !== -1
        ? 'open'
        : now < Date.parse(opensAt)
          ? 'not-yet-open'
          : closesAt && now >= Date.parse(closesAt)
            ? 'closed'
            : 'open';
    var card = signupRoot.querySelector('[data-signup-state="' + state + '"]');
    if (card) card.hidden = false;
  }
</script>

<script>
  import { REGISTRATION_WINDOW } from '@/config/site';
  import { pickSitekey } from '@/lib/captcha';
  import { isValidContactPhone } from '@/lib/contact-phone';
  import { isPlatformEmail } from '@/lib/email';
  import { normaliseNameAnswer } from '@/lib/name-answer';
  import {
    FORCE_OPEN_HOSTS,
    formatMoscowInstant,
    registrationState,
    serverNow,
    type RegistrationState,
  } from '@/lib/registration';
  import { createCombobox } from '@/scripts/combobox';
  import {
    createSettlementIndex,
    expandDirectory,
    normalisePlace,
    settlementNameQuery,
    type Settlement,
    type SettlementDirectory,
    type SettlementIndex,
  } from '@/lib/settlements';
  import { matchSpecialty as findSpecialty } from '@/lib/specialty';
  // `?url`: emitted as a content-hashed `/_astro/` file (immutable cache) and
  // fetched only once the field is focused or holds a value, so the page stays light.
  import SETTLEMENTS_URL from '@/data/settlements.json?url';

  interface Specialty {
    id: string;
    code: string;
    name: string;
    isOther: boolean;
  }

  type CaptchaEvent =
    | 'challenge-visible'
    | 'challenge-hidden'
    | 'token-expired' | 'network-error' | 'javascript-error';

  interface SmartCaptcha {
    render(
      container: HTMLElement,
      params: { sitekey: string; hl?: string; invisible?: boolean; callback?: (token: string) => void },
    ): number;
    execute(widgetId?: number): void;
    reset(widgetId?: number): void;
    subscribe(widgetId: number, event: CaptchaEvent, callback: () => void): () => void;
  }

  type CaptchaWindow = Window & { smartCaptcha?: SmartCaptcha; obSmartCaptchaReady?: () => void };

  const CAPTCHA_SRC =
    'https://smartcaptcha.cloud.yandex.ru/captcha.js?render=onload&onload=obSmartCaptchaReady';
  const SPECIALTIES_URL = '/api/v1/public/specialties';
  const SIGN_UP_URL = '/api/v1/congress/sign-up';

  const MESSAGES = {
    required: 'Заполните это поле.',
    email: 'Введите адрес электронной почты в формате name@example.com.',
    phone: 'Введите номер телефона с кодом страны или города, например +7 (999) 123-45-67.',
    specialty: 'Выберите специальность из списка.',
    specialtiesUnavailable:
      'Не удалось загрузить список специальностей. Обновите страницу, чтобы попробовать ещё раз.',
    consent: 'Чтобы отправить заявку, подтвердите согласие на обработку персональных данных.',
    captcha:
      'Не удалось выполнить проверку «я не робот». Проверьте подключение к интернету и отправьте заявку ещё раз.',
    captchaRefused: 'Не удалось пройти проверку «я не робот». Отправьте заявку ещё раз.',
    invalid: 'Сервер не принял заявку. Проверьте введённые данные и отправьте её ещё раз.',
    rateLimited: 'Слишком много попыток подряд. Подождите несколько минут и отправьте заявку ещё раз.',
    generic:
      'Регистрация временно недоступна, попробуйте через несколько минут. Если ошибка повторится — напишите организаторам.',
  } as const;

  const root = document.querySelector<HTMLElement>('[data-signup]');
  if (root) init(root);

  function init(root: HTMLElement): void {
    const form = root.querySelector<HTMLFormElement>('[data-signup-form]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-signup-submit]')!;
    const alertBox = root.querySelector<HTMLElement>('[data-signup-alert]')!;
    const success = root.querySelector<HTMLElement>('[data-signup-success]')!;
    const specialtyInput = form.querySelector<HTMLInputElement>('#signup-specialty')!;
    const specialtyId = form.querySelector<HTMLInputElement>('[data-specialty-id]')!;
    const sitekey = pickSitekey(window.location.hostname, {
      prod: root.dataset.sitekeyProd ?? '',
      preview: root.dataset.sitekeyPreview ?? '',
    });
    const captchaBox = root.querySelector<HTMLElement>('[data-captcha]');

    let specialties: Specialty[] | null = null;
    let captchaToken = '';
    let captchaWidget: number | undefined;
    // Set while a submit waits for the invisible check; the token callback
    // then carries the submission on.
    let submitAwaitsCaptcha = false;

    const showState = (state: RegistrationState, focus = false): void => {
      for (const card of root.querySelectorAll<HTMLElement>('[data-signup-state]')) {
        card.hidden = card.dataset.signupState !== state;
      }
      if (focus && state !== 'open') {
        root.querySelector<HTMLElement>(`[data-signup-state="${state}"] .ob-signup__stitle`)?.focus();
      }
    };

    let formStarted = false;
    const openForm = (): void => {
      if (formStarted) return;
      formStarted = true;

      // ── Field errors ──────────────────────────────────────────────────────
      const errorFor = (field: HTMLInputElement): HTMLElement | null =>
        document.getElementById(`${field.id}-error`);

      const setError = (field: HTMLInputElement, message: string | null): void => {
        const box = errorFor(field);
        if (message === null) {
          field.removeAttribute('aria-invalid');
          if (box) {
            box.hidden = true;
            box.textContent = '';
          }
          return;
        }
        field.setAttribute('aria-invalid', 'true');
        if (box) {
          box.textContent = message;
          box.hidden = false;
        }
      };

      // The live region is never hidden: some screen-reader and browser pairs
      // skip a region that is revealed and filled in the same tick. It stays in
      // the tree, empty (and so collapsed by `:empty`); only its text changes.
      const setAlert = (message: string | null): void => {
        alertBox.textContent = message ?? '';
      };

      // ── ФИО: the platform's normalisation, shown on blur ──────────────────
      for (const field of form.querySelectorAll<HTMLInputElement>('[data-name-field]')) {
        field.addEventListener('blur', () => {
          field.value = normaliseNameAnswer(field.value);
        });
      }

      const chevronOf = (input: HTMLInputElement): HTMLElement | null =>
        input.parentElement?.querySelector<HTMLElement>('[data-combo-open]') ?? null;

      // ── Specialties: live list, «Другое» pinned last, no free text ─────────
      const matchSpecialty = (typed: string, allowFragment = true): Specialty | null =>
        specialties === null ? null : findSpecialty(specialties, typed, { allowFragment });

      const syncSpecialty = (): void => {
        const match = matchSpecialty(specialtyInput.value);
        specialtyId.value = match?.id ?? '';
        if (match) {
          specialtyInput.value = match.name;
          setError(specialtyInput, null);
        }
      };
      specialtyInput.addEventListener('change', syncSpecialty);
      specialtyInput.addEventListener('blur', syncSpecialty);
      specialtyInput.addEventListener('input', () => {
        // Exact names only while typing: a fragment resolves on change/blur,
        // where the input is rewritten to the full name the participant sees.
        specialtyId.value = matchSpecialty(specialtyInput.value, false)?.id ?? '';
      });

      // The design pins «Другое» under a hairline at the foot of the list,
      // whatever was typed; the rest keep the platform's order.
      const specialtyCombo = createCombobox<Specialty>({
        input: specialtyInput,
        list: form.querySelector<HTMLElement>('#signup-specialty-list')!,
        toggle: chevronOf(specialtyInput),
        options: () => specialties?.filter((s) => !s.isOther) ?? [],
        pinned: () => specialties?.find((s) => s.isOther) ?? null,
        text: (s) => s.name,
        emptyText: 'Ничего не найдено',
        isSelected: (s) => s.id === specialtyId.value,
        onPick: (s) => {
          specialtyInput.value = s.name;
          specialtyId.value = s.id;
          setError(specialtyInput, null);
        },
      });

      fetch(SPECIALTIES_URL, { headers: { Accept: 'application/json' } })
        .then((res) => {
          if (!res.ok) throw new Error(`specialties: HTTP ${res.status}`);
          return res.json() as Promise<{ entries: Specialty[] }>;
        })
        .then(({ entries }) => {
          specialties = entries;
          syncSpecialty();
          specialtyCombo.refresh();
        })
        .catch(() => {
          specialties = [];
          setError(specialtyInput, MESSAGES.specialtiesUnavailable);
        });

      // ── Settlement: directory pick, free text as the fallback ─────────────
      // A pick carries its region; anything else — a foreign or unlisted place,
      // a name found in several regions, or a directory that failed to load —
      // reveals the «Регион» field, which the platform requires separately.
      const cityInput = form.querySelector<HTMLInputElement>('[data-settlement]')!;
      const regionField = form.querySelector<HTMLElement>('[data-region-field]')!;
      const regionInput = form.querySelector<HTMLInputElement>('#signup-region')!;
      const regionHint = form.querySelector<HTMLElement>('[data-region-hint]')!;
      const regionStatus = form.querySelector<HTMLElement>('[data-region-status]')!;
      const cityHint = form.querySelector<HTMLElement>('[data-city-hint]')!;
      let settlementIndex: SettlementIndex | null = null;
      // Pending while the directory is in flight; submit waits for it, so a fast
      // «type the city, press Enter» is not judged against a missing directory.
      let settlementsLoading: Promise<void> | null = null;
      let settlement: Settlement | null = null;

      const REGION_HINTS = {
        unknown: 'Этого населённого пункта нет в\u00a0списке\u00a0— укажите регион или страну.',
        ambiguous:
          'Такой населённый пункт есть в\u00a0нескольких регионах\u00a0— выберите его из\u00a0списка или укажите регион.',
      } as const;

      // Visibility changes only while the participant types in «Населённый
      // пункт» (and at submit), never on blur: a reveal on blur lands after the
      // browser has already chosen the Tab target, and between the press and
      // the release of a tap or click below the row — so that tap is lost.
      const showRegion = (reason: keyof typeof REGION_HINTS): void => {
        const hint = REGION_HINTS[reason];
        const changed = regionField.hidden || regionHint.textContent?.trim() !== hint;
        regionHint.textContent = hint;
        regionField.hidden = false;
        // The field appears silently for a screen reader; this line is announced.
        if (changed) regionStatus.textContent = `Добавлено поле «Регион». ${hint}`;
      };
      const hideRegion = (): void => {
        // Never pull the field out from under the focus — it would drop to <body>.
        if (regionField.hidden || regionField.contains(document.activeElement)) return;
        regionField.hidden = true;
        setError(regionInput, null);
        regionStatus.textContent = '';
      };

      // An entry, once resolved, holds while the field still reads its name or
      // label: «Кировск» picked from the list is one of three Кировски, and
      // re-resolving the bare name would lose which.
      const stillReads = (entry: Settlement | null): entry is Settlement => {
        if (entry === null) return false;
        const typed = normalisePlace(cityInput.value);
        return typed === normalisePlace(entry.name) || typed === normalisePlace(entry.label);
      };

      // The region under the field (design): «Химки» in the input, «Московская
      // область» beneath. A federal city's label is its name alone, so it gets
      // none. Shown or hidden only while typing, on a pick and at submit —
      // never on blur, for the reason `showRegion` gives.
      const showCityHint = (entry: Settlement | null): void => {
        const region = entry && entry.label !== entry.name ? entry.region : '';
        cityHint.textContent = region;
        cityHint.hidden = region === '';
      };

      // Once shown, the field stays until a directory entry resolves: someone
      // correcting «Минск» back through «Мин…» should not watch it flicker.
      const decideRegion = (): void => {
        if (settlementIndex === null) return;
        const status = settlementIndex.status(cityInput.value);
        const resolved = stillReads(settlement)
          ? settlement
          : status.kind === 'match'
            ? status.settlement
            : null;
        showCityHint(resolved);
        if (resolved) hideRegion();
        else if (status.kind === 'ambiguous' || status.kind === 'unknown') showRegion(status.kind);
      };

      // Rewrites a resolved entry to its name (the region is the hint). It runs
      // on blur too, so it must never change the layout — `decideRegion`
      // already settled it.
      const resolveSettlement = (): void => {
        if (!stillReads(settlement)) settlement = settlementIndex?.match(cityInput.value) ?? null;
        if (settlement) {
          cityInput.value = settlement.name;
          setError(cityInput, null);
        }
      };
      cityInput.addEventListener('change', resolveSettlement);
      cityInput.addEventListener('blur', resolveSettlement);
      cityInput.addEventListener('input', () => {
        // Full labels and exact names only while typing; a prefix resolves on
        // change/blur, where the input is rewritten to the name.
        if (!stillReads(settlement)) {
          settlement = settlementIndex?.match(cityInput.value, { allowPrefix: false }) ?? null;
        }
        decideRegion();
      });

      // The directory has thousands of places: the list shows the first few
      // dozen names that BEGIN with what was typed, and narrows as the
      // participant types. A place outside it («Минск») finds none, so no list
      // hangs over the next field while «Регион» is revealed.
      const cityCombo = createCombobox<Settlement>({
        input: cityInput,
        list: form.querySelector<HTMLElement>('#signup-city-list')!,
        toggle: chevronOf(cityInput),
        options: () => settlementIndex?.entries ?? [],
        text: (entry) => entry.name,
        sub: (entry) => (entry.label !== entry.name ? entry.region : null),
        normalise: settlementNameQuery,
        // A same-named place typed with its region («Кировск, Мурманская
        // область») is a choice too; the whole text is compared, so a region
        // that does not fit the name («Химки, Ленинградская») commits nothing.
        exact: { keys: (entry) => [entry.name, entry.label], key: normalisePlace },
        prefixOnly: true,
        limit: 50,
        isSelected: (entry) => entry === settlement,
        onPick: (entry) => {
          settlement = entry;
          cityInput.value = entry.name;
          setError(cityInput, null);
          decideRegion();
        },
      });

      // `AbortSignal.timeout` is Safari 16+ / Chrome 103+; an older engine gets
      // the same deadline from a plain controller instead of a thrown TypeError.
      const deadline = (ms: number): AbortSignal | undefined => {
        if (typeof AbortSignal !== 'undefined' && typeof AbortSignal.timeout === 'function') {
          return AbortSignal.timeout(ms);
        }
        if (typeof AbortController === 'undefined') return undefined;
        const controller = new AbortController();
        window.setTimeout(() => controller.abort(), ms);
        return controller.signal;
      };

      const loadSettlements = (): void => {
        if (settlementIndex !== null || settlementsLoading !== null) return;
        settlementsLoading = fetch(SETTLEMENTS_URL, {
          headers: { Accept: 'application/json' },
          signal: deadline(10_000),
        })
          .then((res) => {
            if (!res.ok) throw new Error(`settlements: HTTP ${res.status}`);
            return res.json() as Promise<SettlementDirectory>;
          })
          .then((directory) => {
            settlementIndex = createSettlementIndex(expandDirectory(directory));
            cityCombo.refresh();
          })
          .catch(() => {
            settlementIndex = createSettlementIndex([]);
          })
          .finally(() => {
            settlementsLoading = null;
            // Decide only while the participant is still in the field: once they
            // have moved on, a reveal could land mid-press on whatever they went
            // to next. Submit decides for a field left before the answer came.
            if (document.activeElement === cityInput) decideRegion();
            else resolveSettlement();
          });
      };
      cityInput.addEventListener('focus', loadSettlements);
      // A value the browser restores on back navigation arrives without a focus.
      if (cityInput.value.trim() !== '') loadSettlements();
      window.addEventListener('pageshow', () => {
        if (cityInput.value.trim() !== '') loadSettlements();
      });

      // ── Captcha state (only when this host has a sitekey) ─────────────────
      const captchaWindow = window as CaptchaWindow;
      const captchaOn = sitekey !== '' && captchaBox !== null;
      const resetCaptcha = (): void => {
        captchaToken = '';
        if (captchaWidget !== undefined) captchaWindow.smartCaptcha?.reset(captchaWidget);
      };

      // ── Validation ────────────────────────────────────────────────────────
      const field = (name: string): HTMLInputElement =>
        form.querySelector<HTMLInputElement>(`[name="${name}"]`)!;

      const validate = (): HTMLElement | null => {
        let first: HTMLElement | null = null;
        const fail = (input: HTMLInputElement, message: string): void => {
          setError(input, message);
          first ??= input;
        };

        for (const name of ['surname', 'firstName', 'patronymic', 'email', 'contactPhone']) {
          const input = field(name);
          input.value = input.dataset.nameField !== undefined ? normaliseNameAnswer(input.value) : input.value.trim();
          setError(input, null);
          if (input.required && input.value === '') fail(input, MESSAGES.required);
          else if (name === 'email' && !isPlatformEmail(input.value)) fail(input, MESSAGES.email);
          else if (name === 'contactPhone' && !isValidContactPhone(input.value)) fail(input, MESSAGES.phone);
        }

        syncSpecialty();
        setError(specialtyInput, null);
        if (specialties !== null && specialties.length === 0) fail(specialtyInput, MESSAGES.specialtiesUnavailable);
        else if (specialtyInput.value.trim() === '') fail(specialtyInput, MESSAGES.required);
        else if (specialtyId.value === '') fail(specialtyInput, MESSAGES.specialty);

        const workplace = field('workplace');
        workplace.value = workplace.value.trim();
        setError(workplace, null);
        if (workplace.value === '') fail(workplace, MESSAGES.required);

        resolveSettlement();
        showCityHint(settlement);
        setError(cityInput, null);
        setError(regionInput, null);
        if (cityInput.value.trim() === '') fail(cityInput, MESSAGES.required);
        else if (settlement === null) {
          // The press is over by now, so the layout may change.
          showRegion(settlementIndex?.status(cityInput.value).kind === 'ambiguous' ? 'ambiguous' : 'unknown');
          regionInput.value = regionInput.value.trim();
          if (regionInput.value === '') fail(regionInput, MESSAGES.required);
        }

        const consent = field('personalDataConsent');
        setError(consent, null);
        if (!consent.checked) fail(consent, MESSAGES.consent);
        return first;
      };

      // ── Submission ────────────────────────────────────────────────────────
      const setBusy = (busy: boolean): void => {
        submit.disabled = busy;
        form.setAttribute('aria-busy', String(busy));
        submit.textContent = busy ? 'Отправляем заявку…' : 'Зарегистрироваться';
      };

      const payload = (): Record<string, string | boolean> => {
        const body: Record<string, string | boolean> = {
          surname: field('surname').value,
          firstName: field('firstName').value,
        };
        const patronymic = field('patronymic').value;
        if (patronymic !== '') body.patronymic = patronymic;
        body.email = field('email').value;
        body.contactPhone = field('contactPhone').value;
        body.specialtyId = specialtyId.value;
        body.workplace = field('workplace').value;
        body.city = settlement?.name ?? cityInput.value.trim();
        body.region = settlement?.region ?? regionInput.value;
        body.personalDataConsent = true;
        if (captchaToken !== '') body.captchaToken = captchaToken;
        return body;
      };

      const refusal = async (res: Response): Promise<{ code?: string; opensAt?: string }> => {
        try {
          return (await res.json()) as { code?: string; opensAt?: string };
        } catch {
          return {};
        }
      };

      const send = async (): Promise<void> => {
        const body = payload();
        setBusy(true);
        let res: Response;
        try {
          res = await fetch(SIGN_UP_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(body),
          });
        } catch {
          setBusy(false);
          resetCaptcha();
          setAlert(MESSAGES.generic);
          return;
        }
        setBusy(false);

        if (res.ok) {
          form.hidden = true;
          // The success block is the card's whole content, so the form's head goes too.
          root.querySelector<HTMLElement>('[data-signup-head]')!.hidden = true;
          root.querySelector<HTMLElement>('[data-signup-email]')!.textContent = String(body.email);
          success.hidden = false;
          root.querySelector<HTMLElement>('[data-signup-success-text]')!.focus();
          return;
        }

        resetCaptcha();
        if (res.status === 400) {
          setAlert(MESSAGES.invalid);
          return;
        }
        if (res.status === 429) {
          setAlert(MESSAGES.rateLimited);
          return;
        }
        if (res.status === 422) {
          const { code, opensAt } = await refusal(res);
          if (code === 'not-yet-open') {
            if (opensAt) {
              try {
                root.querySelector<HTMLElement>('[data-signup-opens-at]')!.textContent =
                  formatMoscowInstant(opensAt);
              } catch {
                // An unparseable instant from the API keeps the configured one.
              }
            }
            showState('not-yet-open', true);
            return;
          }
          if (code === 'closed') {
            showState('closed', true);
            return;
          }
        }
        // Everything else — 401 from a gated upstream, 422 sign-up-unavailable
        // (a platform-side configuration problem), 5xx — is not the participant's
        // to fix, so it never asks them to check their data.
        setAlert(res.status === 403 && captchaOn ? MESSAGES.captchaRefused : MESSAGES.generic);
      };

      // ── Captcha check around a submission ─────────────────────────────────
      // How long a submit may wait before the button comes back with the
      // captcha message. Two bounds: the invisible check itself normally
      // answers in seconds, and a widget that cannot finish (e.g. a key not
      // registered for this host) shows an endless spinner and emits no event
      // at all. So it is short until a challenge is shown. A visible challenge
      // is a person solving it, so they get minutes; closing it ends the wait
      // through `challenge-hidden`. The timeout's reset() also removes the
      // spinner overlay.
      const CAPTCHA_START_MS = 20_000;
      const CAPTCHA_SOLVE_MS = 300_000;
      // `challenge-hidden` also fires right after a pass, possibly before the
      // token callback; only a pop-up closed with no token after this grace
      // counts as the participant cancelling.
      const CHALLENGE_HIDDEN_GRACE_MS = 1_000;
      let captchaWatchdog: number | undefined;
      let captchaScriptFailed = false;

      const stopWaitingForCaptcha = (): void => {
        submitAwaitsCaptcha = false;
        window.clearTimeout(captchaWatchdog);
        captchaWatchdog = undefined;
      };

      // Background failures (no submit waiting) only clear the token; the
      // participant hears about the captcha only when their submit is stuck.
      const captchaFailed = (): void => {
        const pending = submitAwaitsCaptcha;
        stopWaitingForCaptcha();
        resetCaptcha();
        if (pending) {
          setBusy(false);
          setAlert(MESSAGES.captcha);
        }
      };

      const executeCaptcha = (): void => {
        // Invisible mode: execute() runs the check and, once it passes, calls
        // render()'s `callback` with the token — after a pop-up challenge only
        // if Yandex asks for one.
        if (captchaWidget !== undefined) captchaWindow.smartCaptcha?.execute(captchaWidget);
      };

      const attempt = (): void => {
        setAlert(null);
        const invalid = validate();
        if (invalid) {
          setBusy(false);
          invalid.focus();
          return;
        }
        if (captchaOn && captchaToken === '') {
          submitAwaitsCaptcha = true;
          setBusy(true);
          window.clearTimeout(captchaWatchdog);
          captchaWatchdog = window.setTimeout(captchaFailed, CAPTCHA_START_MS);
          if (captchaScriptFailed) captchaFailed();
          // A widget still loading runs the check from renderCaptcha.
          else executeCaptcha();
          return;
        }
        void send();
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (form.getAttribute('aria-busy') === 'true') return;
        // A city typed (or restored without a focus) before the directory has
        // answered is judged against it, not against a missing one. attempt()
        // keeps or drops the busy state from here.
        if (cityInput.value.trim() !== '') loadSettlements();
        if (settlementsLoading) {
          setBusy(true);
          await settlementsLoading;
        }
        attempt();
      });
      // The handler is in place: the button the markup ships disabled may work.
      submit.disabled = false;

      // ── Captcha widget ────────────────────────────────────────────────────
      const renderCaptcha = (): void => {
        const api = captchaWindow.smartCaptcha;
        if (!captchaBox || !api || captchaWidget !== undefined) return;
        const widget = api.render(captchaBox, {
          sitekey,
          hl: 'ru',
          invisible: true,
          callback: (token) => {
            captchaToken = token;
            if (submitAwaitsCaptcha) {
              stopWaitingForCaptcha();
              attempt();
            }
          },
        });
        captchaWidget = widget;
        api.subscribe(widget, 'challenge-visible', () => {
          if (!submitAwaitsCaptcha) return;
          window.clearTimeout(captchaWatchdog);
          captchaWatchdog = window.setTimeout(captchaFailed, CAPTCHA_SOLVE_MS);
        });
        api.subscribe(widget, 'challenge-hidden', () => {
          window.setTimeout(() => {
            if (!submitAwaitsCaptcha || captchaToken !== '') return;
            // Cancelled: a token that still arrives is kept for the next submit.
            stopWaitingForCaptcha();
            setBusy(false);
          }, CHALLENGE_HIDDEN_GRACE_MS);
        });
        // Tokens are single-use and short-lived; the next submit re-executes.
        api.subscribe(widget, 'token-expired', () => {
          captchaToken = '';
        });
        api.subscribe(widget, 'network-error', captchaFailed);
        api.subscribe(widget, 'javascript-error', captchaFailed);
        if (submitAwaitsCaptcha) executeCaptcha();
      };
      if (captchaOn) {
        // The third-party script is requested only once this host is known to
        // have a key, and may finish before or after this module runs.
        if (captchaWindow.smartCaptcha) renderCaptcha();
        else {
          captchaWindow.obSmartCaptchaReady = renderCaptcha;
          const script = document.createElement('script');
          script.src = CAPTCHA_SRC;
          script.defer = true;
          script.addEventListener('error', () => {
            captchaScriptFailed = true;
            captchaFailed();
          });
          document.head.append(script);
        }
      }
    };

    const hostname = window.location.hostname;
    const judge = (now: Date): void => {
      const state = registrationState(REGISTRATION_WINDOW, now, hostname);
      showState(state);
      if (state === 'open') openForm();
    };
    judge(new Date());
    // The device clock only gives the first paint; the server's clock decides,
    // as the platform's does. Force-open hosts are open whatever the time.
    if (!(FORCE_OPEN_HOSTS as readonly string[]).includes(hostname)) {
      fetch(window.location.href, { method: 'HEAD', cache: 'no-store' })
        .then((res) => judge(serverNow(res.headers.get('Date'), new Date())))
        .catch(() => {
          // Offline or blocked: the device clock's answer stands.
        });
    }
  }
</script>
