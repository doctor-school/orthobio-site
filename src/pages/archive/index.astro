---
/** /archive/ — ТЗ §4: хаб-карточки всех сохранённых лет (2021-2026). */
import ArchiveYearCard from '@/components/ArchiveYearCard.astro';
import { getCongressYears, getPage } from '@/content';
import SectionLayout from '@/layouts/SectionLayout.astro';

const { data: page } = await getPage('archive');
const years = await getCongressYears();
---

<SectionLayout page={page}>
  <div class="ob-container ob-section">
    <div class="ob-cards">
      {
        /* The first row is above the fold at every width (one card at 360, up
           to three at 1280) — those covers load eagerly, the rest lazily. */
        years.map((entry, i) => <ArchiveYearCard entry={entry} level="h2" priority={i < 3} />)
      }
    </div>
  </div>
</SectionLayout>
