---
/**
 * BaseLayout — the single HTML shell: <head>, self-hosted fonts, site chrome.
 *
 * Fonts: `@fontsource/inter` is imported here, so Vite emits the woff2 files
 * into the build and the CSS references them locally. Only the weights the
 * design uses (400/500/600/700) and only the Cyrillic + Latin subsets — the
 * unicode-range split means a page fetches just what it renders. NO webfont CDN:
 * the audience is RF physicians and an unreachable CDN would strip the site's
 * typography (AGENTS.md hard constraint).
 */
import '@fontsource/inter/cyrillic-400.css';
import '@fontsource/inter/cyrillic-500.css';
import '@fontsource/inter/cyrillic-600.css';
import '@fontsource/inter/cyrillic-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@/styles/global.css';

import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { SITE } from '@/config/site';

interface Props {
  /** Page title without the site-name suffix. */
  title: string;
  description?: string | null;
  /** Keep the page out of the index (draft fixtures and the 404 document). */
  noindex?: boolean;
}

const { title, description = null, noindex = false } = Astro.props;

// Archive pages take the bare wordmark as their suffix: «ОРТОБИОЛОГИЯ 2021 —
// архив — ОРТОБИОЛОГИЯ 2027 — VIII Конгресс» put two conflicting years in one
// browser tab (content audit М1). The site is still about the 2027 congress —
// only the suffix of a historical page drops the year.
const suffix = Astro.url.pathname.startsWith('/archive/') ? SITE.name : SITE.title;
// The home page IS the site, so it takes no suffix. The `title === suffix`
// guard alone did not cover it: its title and the suffix are the same sentence
// in a different word order («VIII Конгресс ОРТОБИОЛОГИЯ 2027» vs
// «ОРТОБИОЛОГИЯ 2027 — VIII Конгресс»), so the tab read the congress name twice
// (PR #17 review). The route is the honest test — no caller has to know how the
// suffix is spelled.
const pageTitle =
  Astro.url.pathname === '/' || title === suffix ? title : `${title} — ${suffix}`;
// `site` is set in astro.config.mjs, so Astro.site is always defined here.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      /* Icons (audit nit N1): without a declared icon the browser requests
         /favicon.ico on every page and 404s. SVG first for modern browsers,
         32px PNG as the fallback. Generated from the brand mark — see
         `pnpm icons`. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content={SITE.title} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {
      /* The CTA points at a messenger, so the share card is the first thing the
         audience sees — the mark on the page background, not a blank box. */
    }
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="ob-skip" href="#main">Перейти к содержимому</a>
    <SiteHeader path={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
