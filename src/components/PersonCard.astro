---
/**
 * PersonCard — one person as a portrait circle plus name/role. Used by both
 * президиум/обращения and the оргкомитет list (bundle components/people).
 * No portrait → an initial plate (decorative: the name is right next to it).
 * Greeting texts were never published for any year, so `text` is usually null.
 *
 * The portrait is served through `<Image>`: build-time resizing keeps a page
 * openable on mobile data. `inferSize` reads the intrinsic size at build —
 * unlike photos/cover, the schema carries a person's portrait as a plain scalar
 * URL with no dimensions, and `<Image>` writes the measured width/height onto
 * the tag, so the circle reserves its box before the file arrives (no CLS).
 *
 * State of the portrait set (Issue #23): the оргкомитет ships 11 real square
 * derivatives (288×288 webp, `2026/people/`). The обращения cards still show
 * the initial plate for Загородний and Губин — the only files that survive for
 * them are 16:9 title cards of the greeting videos, where a branded plate fills
 * half the frame and a 72px circle showed a green wedge instead of a face
 * (Issue #16). That plate is the design's own state for a person without a
 * usable photo (PersonCard.prompt.md), not a degraded fallback.
 */
import { Image } from 'astro:assets';

import { mediaUrl } from '@/config/site';

interface Props {
  name: string;
  role?: string | null;
  photo?: string | null;
  text?: string | null;
  /**
   * Above the fold — load eagerly. On an archive year page the presidium is the
   * first thing under the header, so lazy-loading those portraits delays the
   * LCP instead of saving anything (audit nit N2).
   */
  priority?: boolean;
}

const { name, role = null, photo = null, text = null, priority = false } = Astro.props;
---

<div class="ob-pc">
  {
    photo ? (
      <Image
        class="ob-pc__photo"
        src={mediaUrl(photo)}
        alt={`Фото: ${name}`}
        inferSize
        widths={[72, 144, 216]}
        sizes="72px"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <span class="ob-pc__initial" aria-hidden="true">
        {name.trim()[0]}
      </span>
    )
  }
  <div class="ob-pc__box">
    <p class="ob-pc__name">{name}</p>
    {role && <p class="ob-pc__role">{role}</p>}
    {text && <p class="ob-pc__text">{text}</p>}
  </div>
</div>
