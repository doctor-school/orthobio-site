---
/**
 * Hero — home page header (bundle components/hero/Hero).
 *
 * The metaball motif at the right edge is `EdgePattern`, shared with
 * /registration so both pages carry the same element (Issue #90).
 * Slots: default = lead paragraphs, `cta`, `stats`, `statsNote` (the caption
 * that keeps the figures readable as PAST results, not 2027 promises).
 */
import EdgePattern from '@/components/EdgePattern.astro';

interface Props {
  overline?: string | null;
  title: string;
  dates?: string | null;
  venue?: string | null;
}

const { overline = null, title, dates = null, venue = null } = Astro.props;
---

<header class="ob-hero">
  <EdgePattern />
  <div class="ob-container ob-hero__in">
    {overline && <p class="ob-hero__overline">{overline}</p>}
    <h1 class="ob-hero__title">{title}</h1>
    {dates && <p class="ob-hero__dates">{dates}</p>}
    {venue && <p class="ob-hero__venue">{venue}</p>}
    <div class="ob-hero__lead"><slot /></div>
    <slot name="cta" />
    <div class="ob-hero__stats"><slot name="stats" /></div>
    <slot name="statsNote" />
  </div>
</header>
