---
/**
 * SiteHeader — wordmark + primary navigation (bundle ui_kits/…/Chrome).
 *
 * Mobile navigation follows the bundle's native <details>/<summary> pattern:
 * no island or custom state machine, while keyboard and no-JS operation stay
 * browser-owned. The horizontal navigation takes over at lg.
 */
// Referenced as a FILE, not inlined: the mark is 15KB of gradient artwork and
// sits in the chrome of all 15 pages, so inlining re-sent it on every
// navigation and never cached. `?url` emits a content-hashed asset that the
// browser fetches once per session (PR #14 review). The 553-byte metaball in
// the hero stays inline — there the request would cost more than the bytes.
import markUrl from '@/assets/orto-mark-color.svg?url';
import { NAV, SITE } from '@/config/site';

interface Props {
  /** Pathname of the current page — drives aria-current. */
  path: string;
}

const { path } = Astro.props;
/** `/archive/2025` marks the «Архив» item; `/` matches only itself. */
const isCurrent = (href: string): boolean =>
  href === '/' ? path === '/' : path === href || path.startsWith(href.replace(/\/$/, '') + '/');
---

<header class="ob-head">
  <div class="ob-container ob-head__in">
    <a class="ob-head__logo" href="/">
      {/* Decorative: the wordmark beside it already names this link. */}
      <img src={markUrl} width="36" height="36" alt="" />
      <span>
        <span class="ob-head__name">{SITE.name}</span>
        <span class="ob-head__sub">{SITE.tagline}</span>
      </span>
    </a>
    <nav class="ob-nav" aria-label="Основная навигация">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <details class="ob-menu">
      <summary aria-label="Меню">
        <svg
          class="ob-menu__icon ob-menu__icon--menu"
          viewBox="0 0 22 22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h16M3 11h16M3 16h16"></path>
        </svg>
        <svg
          class="ob-menu__icon ob-menu__icon--close"
          viewBox="0 0 22 22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M5 5l12 12M17 5 5 17"></path>
        </svg>
      </summary>
      <nav class="ob-menu__panel" aria-label="Меню">
        {
          NAV.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
