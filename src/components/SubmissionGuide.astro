---
/**
 * SubmissionGuide — «Как подать материалы» on /participants (Issue #99): the
 * owner-approved instruction for the congress cabinet, step by step, with the
 * cabinet's own screenshots under the step they illustrate.
 *
 * Built from the «Проживание» section (Accommodation.astro) rather than a new
 * visual language: the same landmark section with a fixed anchor, the same
 * card (`.ob-acc__way`) with a round tile and an h3 head, the same paragraph,
 * link and framed screenshot. Only the step stack and the screenshot column
 * are its own (`.ob-sub*`). No client JS.
 *
 * The tile carries the step number for the eye and is hidden from assistive
 * tech; the heading itself starts with the number, visually hidden, so the
 * outline reads «1. Кто может подать материалы» either way.
 *
 * A step of sub-steps (step 2, sign-in) is a real <ol> with each screenshot
 * under the sub-step it shows; the button sits under the sub-step that names
 * it (owner, 2026-10-07), the site Button in the accommodation CTA placement
 * (full width on a phone), `secondary` because the page's one primary is the
 * hotel booking; its «если не получилось» line is the accommodation note
 * (`.ob-acc__note`, muted). The button's label and URL are site config, never
 * copy.
 *
 * The page has two of these blocks, each at its own fixed anchor (owner,
 * 2026-10-07): «Как подать материалы» (who may submit, sign-in) ends with a
 * pointer to «Как заполнить заявку» (the cabinet steps, no sign-in), so a
 * reader who signed in elsewhere skips straight to the second.
 */
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Shots from '@/components/SubmissionGuideShots.astro';
import { CABINET_LOGIN_LABEL, CABINET_LOGIN_URL } from '@/config/site';
import type { SubmissionGuideBlock } from '@/content';
import { segment } from '@/lib/accommodation';
import { guideStepId } from '@/lib/submission-guide';

interface Props {
  block: SubmissionGuideBlock;
}

const { block } = Astro.props;
const headingId = `${block.anchor}-title`;
const CTAS = { 'cabinet-login': { label: CABINET_LOGIN_LABEL, href: CABINET_LOGIN_URL } } as const;
const steps = block.steps.map((step, i) => {
  const n = i + 1;
  const hrefs = new Map(step.links.map((l) => [l.text, l.href]));
  return {
    ...step,
    n,
    id: guideStepId(block.anchor, n),
    parts: step.text === null ? [] : segment(step.text, [...hrefs.keys()]),
    hrefs,
    items: step.items.map((item) => ({ ...item, cta: item.cta === null ? null : CTAS[item.cta] })),
  };
});
---

<section class="ob-section ob-sub" id={block.anchor} aria-labelledby={headingId}>
  <SectionHeading title={block.heading} id={headingId} />

  <div class="ob-sub__steps">
    {
      steps.map((step) => (
        <article class="ob-acc__way" id={step.id} aria-labelledby={`${step.id}-title`}>
          <div class="ob-acc__wayhead">
            <span class="ob-acc__ico ob-sub__num" aria-hidden="true">
              {step.n}
            </span>
            <h3 class="ob-acc__wayt" id={`${step.id}-title`}><span class="ob-sr-only">{`${step.n}. `}</span>{step.title}</h3>
          </div>
          {step.parts.length > 0 && (
            <p class="ob-acc__p">
              {step.parts.map((s) =>
                s.mark ? <a class="ob-acc__link" href={step.hrefs.get(s.mark)}>{s.text}</a> : s.text,
              )}
            </p>
          )}
          {step.items.length > 0 && (
            <ol class="ob-list ob-sub__items">
              {step.items.map((item) => (
                <li>
                  {item.text}
                  {item.cta && (
                    <Button class="ob-acc__cta ob-sub__cta" variant="secondary" size="lg" href={item.cta.href} external>
                      {item.cta.label}
                    </Button>
                  )}
                  {item.shots.length > 0 && <Shots shots={item.shots} />}
                </li>
              ))}
            </ol>
          )}
          {step.shots.length > 0 && <Shots shots={step.shots} />}
          {step.note && (
            <p class="ob-acc__note">
              <span><em>{step.note.lead}</em> {step.note.text}</span>
            </p>
          )}
        </article>
      ))
    }
  </div>
  {
    block.next && (
      <p class="ob-sub__next">
        <a class="ob-acc__link" href={`#${block.next.anchor}`}>
          {block.next.text} <span aria-hidden="true">↓</span>
        </a>
      </p>
    )
  }
</section>
