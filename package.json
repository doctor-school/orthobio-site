{
  "name": "orthobio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit",
    "lint:css": "node --experimental-strip-types scripts/check-css-policy.ts",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "redirects:build": "node scripts/generate-nginx-redirects.mjs",
    "assets:svgo": "svgo --folder src/assets --recursive --multipass"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.1.6",
    "typograf": "^7.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^4.0.0",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/css-tree": "^2.3.11",
    "@types/node": "^22.20.1",
    "css-tree": "^3.2.1",
    "parse5": "^8.0.1",
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
