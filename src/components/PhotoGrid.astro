---
/**
 * PhotoGrid — фотоотчёт года (bundle components/archive/PhotoGrid v2).
 *
 * Three things beyond a plain grid. All three are CSS/HTML and all three keep
 * working with the module at the bottom of this file switched off — the one
 * island this component ships is an upgrade, never a dependency, which is how
 * it clears «no client-side JS by default» (AGENTS.md). What it adds and why
 * only JS can add it: «`:target` alone is only half a modal», below.
 * • reportage grid: the first photo occupies a 2×2 cell from 640px up;
 * • everything past `visible` hides inside a native <details>, so a year with
 *   80 photos does not bury the sections under it;
 * • click-to-enlarge is a `:target` lightbox — each photo has a full-screen
 *   `<div id>` that the tile links to, with ←/→ links cycling through the set
 *   and the backdrop/✕ linking back to the grid anchor.
 *
 * The originals in the bucket are camera JPEGs up to 5811px wide, so `<Image>`
 * resizes them at BUILD time and emits a `srcset`: a tile and a lightbox frame
 * are separate size ladders, and a phone on mobile data never downloads a 3MB
 * original. The intrinsic ratio comes from the content model (the schema
 * requires width/height), which is what reserves layout space and keeps CLS at
 * zero; `displaySize()` caps the largest variant we ask sharp to produce.
 *
 * `:target` alone is only half a modal — it paints one, but Escape did nothing,
 * Tab walked straight off the ✕/←/→ onto page controls hidden behind the
 * 93%-opaque scrim, and closing dropped focus at the gallery anchor instead of
 * the tile the reader came from. The island at the bottom of this file closes
 * that gap (Issue #32) and nothing else: it UPGRADES the CSS lightbox the way
 * VideoCard's island upgrades its anchor. With no JS at all the fragment
 * lightbox still opens and closes exactly as it always did.
 *
 * `aria-modal` is therefore written by the script and never by this template:
 * the attribute promises that everything behind the scrim is unreachable, and
 * nothing but a running focus trap makes that promise true.
 *
 * What navigating by fragment still costs, so the next reader does not file it
 * as a defect: the Android Back gesture walks the history backwards one photo
 * at a time (open + n arrows = n+2 entries) rather than dismissing the overlay,
 * and closing returns the page to the gallery anchor rather than to the scroll
 * position the frame was opened from. Escape reuses the ✕'s own navigation on
 * purpose, so keyboard and pointer leave identical history and land identically.
 */
import { Image } from 'astro:assets';

import { mediaUrl } from '@/config/site';
import type { CongressEntry } from '@/content';
import { displaySize } from '@/lib/congress';

interface Props {
  photos: CongressEntry['data']['photos'];
  year: number;
  /** Tiles shown before the «Показать все фото» disclosure. */
  visible?: number;
  /** Anchor base — only needed if a page ever renders two galleries. */
  id?: string;
  /**
   * Tiles link to a full-screen frame. `false` renders the grid alone — no
   * anchors, no frames — for a context where a fragment link would fight the
   * page (a teaser inside another `:target` surface). No caller needs it yet;
   * it is here because the design's contract has it (bundle PhotoGrid props).
   */
  lightbox?: boolean;
}

const { photos, year, visible = 11, id, lightbox = true } = Astro.props;

const base = id ?? `pg${year}`;
/**
 * A disclosure that reveals one or two tiles costs a click and a label to save
 * half a screen — 2022 and 2025 hold exactly 12 photos against a default of 11,
 * so «Показать все фото (12)» used to unfold a SINGLE tile (PR #17 review). The
 * default comes from the design's 80-photo demo, where it is right; the floor
 * below keeps it right for the sets we actually have.
 */
const MIN_HIDDEN = 3;
const shown = photos.length - visible < MIN_HIDDEN ? photos.length : visible;
const head = photos.slice(0, shown);
const rest = photos.slice(shown);

/** Tile widths across the ladder: two columns at 360 → four at 1280. */
const TILE_WIDTHS = [320, 480, 640];
const TILE_MAX = 640;
const TILE_SIZES = '(min-width: 1024px) 300px, (min-width: 640px) 33vw, 46vw';

/**
 * The lead tile is a 2×2 cell from 640px up (see `.ob-pg__grid--lead`), so it
 * renders at roughly twice the width of its neighbours — 570px at a 1280px
 * viewport — and the shared `TILE_SIZES` was asking the browser for a 300px
 * variant, i.e. a 1.9× upscale that showed as visibly soft lettering next to the
 * crisp tiles beside it (a11y audit of PR #17). One `sizes` string cannot serve
 * both, because `sizes` is per-image and this image alone spans two columns.
 */
const LEAD_WIDTHS = [480, 640, 960, 1280];
const LEAD_MAX = 1280;
const LEAD_SIZES = '(min-width: 1024px) 620px, (min-width: 640px) 66vw, 46vw';

/** Lightbox frame: capped at the design's `max-width: min(1100px, 94vw)`. */
const FRAME_WIDTHS = [640, 1100];
const FRAME_MAX = 1100;
const FRAME_SIZES = '(min-width: 1170px) 1100px, 94vw';

const altOf = (
  photo: CongressEntry['data']['photos'][number],
  index: number,
): string => photo.alt ?? `Конгресс ОРТОБИОЛОГИЯ ${year}, фото ${index + 1}`;
---

{
  photos.length > 0 && (
    <div class="ob-pg" id={base}>
      <div class="ob-pg__grid ob-pg__grid--lead">
        {head.map((p, i) => {
          // Only the first tile of the head grid gets the 2×2 cell, so only it
          // gets the wider ladder.
          const lead = i === 0;
          const size = displaySize(p.width, p.height, lead ? LEAD_MAX : TILE_MAX);
          const img = (
            <Image
              src={mediaUrl(p.url)}
              alt={altOf(p, i)}
              width={size.width}
              height={size.height}
              widths={lead ? LEAD_WIDTHS : TILE_WIDTHS}
              sizes={lead ? LEAD_SIZES : TILE_SIZES}
              loading="lazy"
              decoding="async"
            />
          );
          return lightbox ? (
            <a class="ob-pg__it" href={`#${base}-${i + 1}`}>
              {img}
            </a>
          ) : (
            <span class="ob-pg__it">{img}</span>
          );
        })}
      </div>

      {rest.length > 0 && (
        <details class="ob-pg__more">
          <summary>
            <span class="ob-pg__sum-show">Показать все фото ({photos.length})</span>
            <span class="ob-pg__sum-hide">Свернуть фотоотчёт</span>
          </summary>
          <div class="ob-pg__grid">
            {rest.map((p, i) => {
              const index = i + shown;
              const size = displaySize(p.width, p.height, TILE_MAX);
              const img = (
                <Image
                  src={mediaUrl(p.url)}
                  alt={altOf(p, index)}
                  width={size.width}
                  height={size.height}
                  widths={TILE_WIDTHS}
                  sizes={TILE_SIZES}
                  loading="lazy"
                  decoding="async"
                />
              );
              return lightbox ? (
                <a class="ob-pg__it" href={`#${base}-${index + 1}`}>
                  {img}
                </a>
              ) : (
                <span class="ob-pg__it">{img}</span>
              );
            })}
          </div>
        </details>
      )}

      {lightbox && photos.map((p, i) => {
        const prev = ((i - 1 + photos.length) % photos.length) + 1;
        const next = ((i + 1) % photos.length) + 1;
        const size = displaySize(p.width, p.height, FRAME_MAX);
        return (
          <div class="ob-pg__lb" id={`${base}-${i + 1}`} role="dialog" aria-label={altOf(p, i)}>
            {/* Click-outside closes; kept out of the tab order because the ✕
                right next to it is the same action with a real label. */}
            <a class="ob-pg__bg" href={`#${base}`} aria-label="Закрыть" tabindex="-1" />
            <a class="ob-pg__close" href={`#${base}`} aria-label="Закрыть">
              ✕
            </a>
            <figure>
              <Image
                src={mediaUrl(p.url)}
                alt={altOf(p, i)}
                width={size.width}
                height={size.height}
                widths={FRAME_WIDTHS}
                sizes={FRAME_SIZES}
                loading="lazy"
                decoding="async"
              />
              <a class="ob-pg__nav ob-pg__nav--prev" href={`#${base}-${prev}`} aria-label="Предыдущее фото">
                ←
              </a>
              <a class="ob-pg__nav ob-pg__nav--next" href={`#${base}-${next}`} aria-label="Следующее фото">
                →
              </a>
              <figcaption>
                <span>{altOf(p, i)}</span>
                <span>
                  {i + 1} / {photos.length}
                </span>
              </figcaption>
            </figure>
          </div>
        );
      })}
    </div>
  )
}

<script>
  /**
   * The keyboard half of the `:target` lightbox (Issue #32).
   *
   * State lives in three facts the CSS cannot hold: which frame is open
   * (`:target`), which tile opened it, and which control the reader should land
   * on in the frame being navigated to. Everything else — showing, hiding,
   * closing, the scroll lock — stays in `components.css`, so a failure to run
   * this module costs the modality and nothing more.
   *
   * Delegated once per page like the VideoCard island: a year page renders one
   * frame per photo, up to 80 of them by the design's own demo. Astro 6 inlines
   * this import-less script into every page that uses the component, which is
   * both why pages without a gallery ship zero JS and why a future
   * `script-src 'self'` on either nginx vhost would need a hash
   * or a real file here — the e2e suite runs against `astro preview` with no
   * such headers and would stay green while this died in production.
   */
  const CLOSE = '.ob-pg__close';

  /**
   * The frame's tab stops, in document order — today ✕, ←, → and nothing else.
   *
   * Derived from what the BROWSER considers focusable rather than from a list
   * of the elements that happen to be in there now, because the edges of this
   * list are the edges of the trap: a `<button>` added to a frame tomorrow (a
   * zoom, a download) would fall outside a hand-written `a[href]` selector, and
   * the wrap would then fire one stop early and let Tab out onto the page
   * behind the scrim — silently, with no markup obviously at fault.
   *
   * `tabIndex >= 0` is that browser answer in one property: it is 0 for an
   * anchor with an href and for a button, −1 for the `<figure>`/`<img>` around
   * them, and −1 for the backdrop, which carries an explicit `tabindex="-1"`
   * because it is the ✕'s action without the ✕'s label.
   */
  const tabStops = (frame: HTMLElement) =>
    [...frame.querySelectorAll<HTMLElement>('*')].filter(
      (el) => el.tabIndex >= 0 && !el.hasAttribute('disabled'),
    );

  /** The tile that opened the overlay — kept across ←/→, because the reader
   *  came from that photo and not from the one they walked to. */
  let trigger: HTMLElement | null = null;
  /** Which control to land on in the frame we are heading for. Landing on → again
   *  after → is what makes «next, next, next» work at all. */
  let landing = CLOSE;

  const openFrame = () => document.querySelector<HTMLElement>('.ob-pg__lb:target');

  document.addEventListener('click', (event) => {
    // A modified or middle click opens the photo in another tab and leaves THIS
    // one where it is — no navigation, no `hashchange`. Recording a trigger for
    // it would leave a stale tile behind that `trigger ??=` then prefers over
    // the real one, and the next Escape would hand focus to a photo the reader
    // never opened. Same guard, same reason as the VideoCard island.
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return;
    }
    const target = event.target;
    if (!(target instanceof Element)) return;
    // Runs for keyboard activation too: Enter on an anchor dispatches a click.
    const link = target.closest<HTMLAnchorElement>('a.ob-pg__it[href^="#"], a.ob-pg__nav');
    if (!link) return;
    if (link.classList.contains('ob-pg__nav')) {
      landing = link.classList.contains('ob-pg__nav--next')
        ? '.ob-pg__nav--next'
        : '.ob-pg__nav--prev';
    } else {
      trigger = link;
      landing = CLOSE;
    }
  });

  /**
   * Reconcile with the fragment. Called on every hash change and once at load,
   * so a deep link straight into a frame is as operable as a click on a tile.
   */
  const sync = () => {
    const frame = openFrame();
    for (const stale of document.querySelectorAll('.ob-pg__lb[aria-modal]')) {
      if (stale !== frame) stale.removeAttribute('aria-modal');
    }

    if (!frame) {
      const back = trigger;
      trigger = null;
      landing = CLOSE;
      if (!back) return;
      // A DERIVED trigger can sit in the collapsed <details> that holds the
      // tail of the gallery — deep-link to a photo past `visible`, press Esc,
      // and `focus()` on a `display: none` tile does nothing at all, dropping
      // the reader at the top of the document. Unreachable with today's content
      // (12 photos against a floor of 11 + 3 keeps the disclosure unrendered)
      // and one YAML edit away from being reachable, so the disclosure is
      // opened rather than left to be rediscovered as a bug.
      const disclosure = back.closest('details');
      if (disclosure && !disclosure.open) disclosure.open = true;
      // `preventScroll`: the navigation that closed the frame has already put
      // the gallery anchor where the ✕ has always put it, and pulling the page
      // to the tile instead would change what the pointer path does.
      back.focus({ preventScroll: true });
      return;
    }

    frame.setAttribute('aria-modal', 'true');
    // A deep link has no trigger to remember, so derive one: exactly one tile
    // points at any given frame.
    trigger ??= document.querySelector<HTMLElement>(
      `a.ob-pg__it[href="#${CSS.escape(frame.id)}"]`,
    );
    (frame.querySelector<HTMLElement>(landing) ?? tabStops(frame)[0])?.focus();
  };

  window.addEventListener('hashchange', sync);
  /**
   * The one-shot reconcile for a deep link cannot run at module time: Chrome
   * resolves the document's target element as part of the post-load scroll to
   * the fragment, so at `readyState: interactive` — when this deferred module
   * runs — `:target` matches nothing and the frame is still `display: none`,
   * which silently makes the `focus()` below a no-op. `load` is the first
   * moment the CSS lightbox is actually open. Every later transition arrives
   * through `hashchange`, which fires after the fragment is applied.
   */
  if (document.readyState === 'complete') sync();
  else window.addEventListener('load', sync, { once: true });

  document.addEventListener('keydown', (event) => {
    const frame = openFrame();
    if (!frame) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      // Escape IS the ✕ — the same navigation, so both produce one history
      // entry and the same landing anchor.
      frame.querySelector<HTMLAnchorElement>(CLOSE)?.click();
      return;
    }
    if (event.key !== 'Tab') return;

    const stops = tabStops(frame);
    if (stops.length === 0) return;
    const first = stops[0];
    const last = stops[stops.length - 1];
    const active = document.activeElement;
    // Off the trailing edge, or adrift outside the overlay entirely (the frame
    // that had focus is `display: none` the moment the fragment moves on).
    if (!frame.contains(active) || active === (event.shiftKey ? first : last)) {
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    }
  });
</script>
