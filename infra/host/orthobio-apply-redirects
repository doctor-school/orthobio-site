#!/bin/sh
# Installs the deployed redirect snippet into nginx. Runs as root, invoked only
# through /usr/local/bin/orthobio-deploy. Installed at
# /usr/local/sbin/orthobio-apply-redirects.
#
# The snippet arrives in a directory the CI key can write, and it is `include`d
# by a vhost on a host that also fronts Mattermost and Zitadel. So it is
# line-by-line allowlisted before it is installed, and the previous version is
# restored if `nginx -t` rejects the result. Without the restore, a bad snippet
# would sit in /etc/nginx and take the whole host's nginx down at the next
# unrelated reload (certbot renews on a timer).
set -eu

SRC=/var/www/orthobio-site/redirects.conf
DST=/etc/nginx/snippets/orthobio-redirects.conf
BACKUP=/etc/nginx/snippets/.orthobio-redirects.conf.prev

if [ ! -f "$SRC" ]; then
    echo "orthobio-apply-redirects: $SRC missing — deploy the snippet first" >&2
    exit 1
fi

# Snapshot before validating. $SRC sits inside the rrsync jail, so the same key
# that can invoke this script can also rewrite it — validating $SRC and then
# installing $SRC is a TOCTOU against exactly the actor this allowlist defends
# against (PR #15 review). Everything below reads the snapshot, so the bytes
# that are checked are the bytes that land in /etc/nginx.
STAGED=$(mktemp /tmp/orthobio-redirects.XXXXXX)
trap 'rm -f "$STAGED"' EXIT INT TERM
cat "$SRC" > "$STAGED"

# Allowlist: blank lines, comments, and the block shapes the generator emits.
# Any other line — an `include`, a `root`, a `server` — is a refusal. The
# character classes mirror SAFE_PATH / SAFE_QUERY_VALUE in
# scripts/redirects.mjs and exclude every nginx metacharacter: no `;` (a second
# directive), no `#` (a comment swallowing our own `;` and `}`), no stray
# quotes, no `$`, no whitespace.
#
# Since Issue #24 the generator also emits MULTI-LINE blocks, for the
# query-conditional redirects that carry `/company?i=<id>` to the partner
# profiles: an opening `location = /x {`, one indented `if ($arg_… = "…")` per
# condition, an optional indented fallthrough `return`, and a closing `}`.
#
# A line allowlist ALONE cannot police that shape, because two of its lines are
# only safe INSIDE a block (PR #40 review). A file consisting of the single line
# `    return 301 https://elsewhere/;` matches, is `include`d directly into
# `server {}`, is valid nginx — and 301s the entire site. `nginx -t` passes, so
# the rollback below never fires and the snippet stays installed. That is the
# one shape whose blast radius is a SERVED config rather than a rejected one.
# Structure is therefore checked separately, by depth, in the awk pass below.
#
# Each alternative is SINGLE-quoted so the bytes here are the bytes grep sees.
# Double quotes would be a trap: sh expands `\$` to `$` inside them, silently
# turning the literal `$` of a rewrite pattern into an end-of-line anchor.

# Redirect target: a root-relative path, or an https URL on a host we control.
#
# Both halves are load-bearing. The path arm must reject `//host/path`, which a
# browser resolves as an EXTERNAL url — hence the first character after the
# leading `/` is drawn from a class WITHOUT `/`. The absolute arm names its
# hosts instead of accepting any `https://…`: `doctor.school` is where the
# November platform migration points (see infra/redirects.yaml), `orthobio.ru`
# is us. Anything else — including a bare `evil.example` with no scheme at all —
# is not a destination this site redirects to. Adding a host at migration time
# is a one-line edit here.
TC='[A-Za-z0-9._~/%!&()*+,=:@?-]'
TC1='[A-Za-z0-9._~%!&()*+,=:@?-]'
TGT="(/($TC1$TC*)?|https://(doctor\.school|orthobio\.ru)(/$TC*)?)"

A_BLANK='^[[:space:]]*(#.*)?$'
A_EXACT="^location = /[A-Za-z0-9._~/%!&()*+,=:@-]* \\{ return 30[1278] $TGT; \\}\$"
A_PREFIX="^location \\^~ /[A-Za-z0-9._~/%!&()*+,=:@-]* \\{ rewrite \\^[A-Za-z0-9._~/%!&()*+,=:@\\\\-]+\\(\\.\\*\\)\\\$ $TGT\\\$1 (permanent|redirect); \\}\$"
A_ROOT="^location ~ \\^/\\(\\?!\\\\.\\)\\(\\.\\*\\)\\\$ \\{ return 30[1278] $TGT\\\$1; \\}\$"
# Multi-line query-conditional block (Issue #24): open, conditions, optional
# fallthrough, close.
A_OPEN='^location = /[A-Za-z0-9._~/%!&()*+,=:@-]* \{$'
A_IF="^    if \\(\\\$arg_[A-Za-z0-9_]+ = \"[A-Za-z0-9._~/%!&()*+,=:@-]+\"\\) \\{ return 30[1278] $TGT; \\}\$"
A_RETURN="^    return 30[1278] $TGT;\$"
A_CLOSE='^\}$'

if grep -nvE "$A_BLANK|$A_EXACT|$A_PREFIX|$A_ROOT|$A_OPEN|$A_IF|$A_RETURN|$A_CLOSE" "$STAGED"; then
    echo "orthobio-apply-redirects: refused — line(s) above are not generator output" >&2
    exit 1
fi

# Block structure, by DEPTH — not by counting braces.
#
# The snippet is `include`d INSIDE `server {}`, so it must open and close
# exactly the blocks it declares, and it must never contain a directive at the
# top level. A counter cannot express either: `location = /a {` / `}` / `}` /
# `location = /b {` balances 2:2 while closing the vhost's own block, and a `{`
# inside an nginx COMMENT balances the books without nginx ever seeing it.
#
# Comments are stripped first for that reason. `if`/`return` at depth 0 is the
# hijack described above; a negative depth is a `}` closing someone else's
# block; a non-zero depth at EOF leaves the vhost hanging open.
if ! awk '
    { line = $0; sub(/#.*/, "", line) }
    line ~ /^[[:space:]]*(if|return)/ && depth == 0 {
        printf "line %d: `%s` is a directive at the top level of the snippet\n", NR, $0 > "/dev/stderr"
        bad = 1
    }
    {
        opens = gsub(/\{/, "{", line)
        closes = gsub(/\}/, "}", line)
        depth += opens - closes
    }
    depth < 0 {
        printf "line %d: closes a block the snippet did not open\n", NR > "/dev/stderr"
        bad = 1
        exit
    }
    END {
        if (bad) exit 1
        if (depth != 0) {
            printf "%d block(s) left open at end of file\n", depth > "/dev/stderr"
            exit 1
        }
    }
' "$STAGED"; then
    echo "orthobio-apply-redirects: refused — block structure is not generator output" >&2
    exit 1
fi

mkdir -p "$(dirname "$DST")"
# Not `[ -f "$DST" ] && cp …` — under `set -e` a false test would exit the
# script on the very first (no-previous-version) run.
if [ -f "$DST" ]; then
    cp -p "$DST" "$BACKUP"
fi

install -o root -g root -m 0644 "$STAGED" "$DST"

if ! nginx -t; then
    echo "orthobio-apply-redirects: nginx rejected the config — rolling back" >&2
    if [ -f "$BACKUP" ]; then
        install -o root -g root -m 0644 "$BACKUP" "$DST"
    else
        rm -f "$DST"
    fi
    nginx -t
    exit 1
fi

systemctl reload nginx
echo "orthobio-apply-redirects: installed and reloaded"
