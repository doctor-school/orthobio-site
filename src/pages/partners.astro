---
/**
 * /partners — ТЗ §4: уровни партнёрства + контакт.
 *
 * The page OPENS with the honest stub «партнёры 2027 будут объявлены»
 * (`blocks` in partners.yaml) — before this the whole body of a 2027 page was
 * the 2026 registry, whose tier headings repeat the very same five level names
 * offered above, so the roster read as «уже занятые слоты» (content audit К1).
 * The registry stays, but under an overline that names the congress it belongs
 * to, a counter of what is in it, and a year inside EVERY tier heading — the
 * audit made that last one the condition for keeping the registry on the page
 * at all, because the tier headings are where the double reading happens.
 *
 * The «стать партнёром» action is a mailto: built from the owner-approved
 * CONTACT_EMAIL (Issue #54). The null fallback stays honest for a future config
 * transition instead of shipping a broken link (content audit К2).
 */
import PartnerTier from '@/components/PartnerTier.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import { CONTACT_EMAIL, REGISTRATION_OPENS } from '@/config/site';
import { getCongressYear, getPage } from '@/content';
import SectionLayout from '@/layouts/SectionLayout.astro';
import { groupPartners, nbsp, plural } from '@/lib/congress';

const REFERENCE_YEAR = 2026;

const { data: page } = await getPage('partners');
const reference = await getCongressYear(REFERENCE_YEAR);
// Sponsor/exhibitor tiers only — organizing bodies belong to /orgs.
const sponsorTiers = groupPartners(reference?.data.partners ?? []).filter(
  (g) => g.tier !== 'organizer' && g.tier !== 'co-organizer',
);
// Counter of what the section actually renders, not of the year's full roster
// (organizers are on /orgs).
const sponsorCount = sponsorTiers.reduce((sum, g) => sum + g.items.length, 0);
---

<SectionLayout page={page}>
  <div class="ob-container ob-section">
    {
      CONTACT_EMAIL ? (
        <Button variant="secondary" href={`mailto:${CONTACT_EMAIL}`}>
          Стать партнёром — написать команде конгресса
        </Button>
      ) : (
        <p class="ob-note">
          Адрес оргкомитета для партнёрских запросов будет опубликован к открытию регистрации — {
            REGISTRATION_OPENS.nominative
          }.
        </p>
      )
    }
  </div>

  <div class="ob-container ob-section" id="p26">
    <SectionHeading
      overline={`VII конгресс · ${REFERENCE_YEAR}`}
      title={`Партнёры конгресса ${REFERENCE_YEAR}`}
      meta={
        sponsorCount > 0
          ? nbsp(sponsorCount, plural(sponsorCount, ['партнёр', 'партнёра', 'партнёров']))
          : null
      }
      linkLabel={`Всё о конгрессе ${REFERENCE_YEAR}`}
      linkHref={`/archive/${REFERENCE_YEAR}`}
    />
    {
      sponsorTiers.length > 0 ? (
        sponsorTiers.map((group) => (
          /* The year goes into every tier heading, not just the section H2:
             those five labels are the same five levels offered above as the
             2027 structure, and a reader scanning h3s saw them as filled slots
             (content audit К1, review of PR #17). */
          <PartnerTier
            tier={group.tier}
            label={group.label}
            partners={group.items}
            year={REFERENCE_YEAR}
          />
        ))
      ) : (
        <p class="ob-empty">нет данных</p>
      )
    }
  </div>
</SectionLayout>
