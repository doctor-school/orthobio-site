---
/**
 * /archive/<year> — единый шаблон года (ТЗ §4): заголовок, президиум,
 * программа, фотогалерея, сборник тезисов, партнёры года.
 *
 * Renders ONLY from the congress collection: adding a year is a YAML file, not
 * markup. The four blocks the ТЗ names as the year template always render — an
 * absent one says «нет данных» rather than silently disappearing; the optional
 * blocks (оргкомитет, видео, постеры) appear only when the year has them.
 * Nothing is ever borrowed from a neighbouring year.
 */
import { Image } from 'astro:assets';

import CommitteeList from '@/components/CommitteeList.astro';
import DocCard from '@/components/DocCard.astro';
import PartnerTier from '@/components/PartnerTier.astro';
import PersonCard from '@/components/PersonCard.astro';
import PhotoGrid from '@/components/PhotoGrid.astro';
import ProgramSession from '@/components/ProgramSession.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import VideoCard from '@/components/VideoCard.astro';
import { mediaUrl } from '@/config/site';
import { getCongressYears, type CongressEntry } from '@/content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  displaySize,
  groupPartners,
  groupSessionsByDay,
  nbsp,
  ordinalLabel,
  plural,
} from '@/lib/congress';

export async function getStaticPaths() {
  // Drafts are filtered inside getCongressYears() — a fixture must never get a
  // public route.
  const years = await getCongressYears();
  return years.map((entry) => ({ params: { year: entry.id }, props: { entry } }));
}

interface Props {
  entry: CongressEntry;
}

const { entry } = Astro.props;
const c = entry.data;

const NO_DATA = 'нет данных';

const sessions = c.program?.sessions ?? [];
const days = groupSessionsByDay(sessions);
const talkCount = sessions.reduce((sum, s) => sum + s.talks.length, 0);
const programSummary =
  sessions.length > 0
    ? [
        nbsp(sessions.length, plural(sessions.length, ['сессия', 'сессии', 'сессий'])),
        nbsp(talkCount, plural(talkCount, ['доклад', 'доклада', 'докладов'])),
      ].join(' · ')
    : null;

// «Нет данных» must hang on structure, not luck: `c.program` can be a non-null
// object with nothing in it (`{ pdf: null, sessions: [] }` is schema-valid), and
// truthiness alone would then render an empty section instead of the honest
// placeholder (PR #14 review).
const hasProgram = Boolean(c.program?.pdf) || sessions.length > 0;

const partnerGroups = groupPartners(c.partners);
const posterImages = c.posters.filter(
  (p): p is typeof p & { width: number; height: number } => p.width !== null && p.height !== null,
);
const posterDocs = c.posters.filter((p) => p.width === null || p.height === null);
const POSTER_WIDTHS = [320, 480, 640];
const POSTER_MAX = 640;

const meta = [c.dates ?? NO_DATA, c.place].filter(Boolean).join(' — ');
const title = c.title ?? `ОРТОБИОЛОГИЯ ${c.year}`;
const description = `${title}. ${meta}. Программа, фотоотчёт и материалы конгресса в архиве.`;
---

{
  /* `c.draft` is always false on this route today — getStaticPaths() takes its
     years from getCongressYears(), which filters drafts out. The noindex flag
     and the draft banner below are the belt to that braces: if the filter is
     ever relaxed (e.g. to preview a fixture), a draft still cannot enter the
     index or pass for a real congress. Deliberately kept, not dead by accident
     (PR #14 review). */
}
<BaseLayout title={`${title} — архив`} description={description} noindex={c.draft}>
  <div class="ob-yh">
    <div class="ob-container ob-yh__in">
      {c.draft && <p class="ob-yh__draft">Черновик / фикстура — не публиковать</p>}
      <p class="ob-yh__num">{ordinalLabel(c.number)} · Архив</p>
      <h1 class="ob-yh__title">{title}</h1>
      <p class="ob-yh__meta">{meta}</p>
    </div>
  </div>

  <div class="ob-container ob-section">
    <SectionHeading title="Президиум и обращения" />
    {
      c.greetings.length > 0 ? (
        <div class="ob-cards--narrow ob-cards">
          {c.greetings.map((g, i) => (
            <PersonCard
              name={g.name}
              role={g.role}
              photo={g.photo}
              text={g.text}
              priority={i < 2}
            />
          ))}
        </div>
      ) : (
        <p class="ob-empty">{NO_DATA}</p>
      )
    }
  </div>

  {
    c.committee.length > 0 && (
      <div class="ob-container ob-section">
        <SectionHeading title="Оргкомитет" />
        <CommitteeList members={c.committee} />
      </div>
    )
  }

  <div class="ob-container ob-section">
    <SectionHeading title="Программа" />
    {programSummary && <p class="ob-note">{programSummary}</p>}
    {c.program?.pdf && <DocCard href={c.program.pdf} title={`${title}. Программа конгресса`} />}
    {
      days.map((day) => (
        <>
          <h3 class="ob-prog__day">{day.label}</h3>
          <div class="ob-prog__grid">
            {day.sessions.map((session) => (
              <ProgramSession session={session} level="h4" />
            ))}
          </div>
        </>
      ))
    }
    {!hasProgram && <p class="ob-empty">{NO_DATA}</p>}
  </div>

  <div class="ob-container ob-section">
    <SectionHeading title="Фотоотчёт" />
    {
      c.photos.length > 0 ? (
        <PhotoGrid photos={c.photos} year={c.year} />
      ) : (
        <p class="ob-empty">{NO_DATA}</p>
      )
    }
  </div>

  {
    c.videos.length > 0 && (
      <div class="ob-container ob-section">
        <SectionHeading title="Видео" />
        <div class="ob-cards">
          {c.videos.map((v) => (
            <VideoCard url={v.url} title={v.title} year={c.year} />
          ))}
        </div>
      </div>
    )
  }

  <div class="ob-container ob-section">
    <SectionHeading title="Сборник тезисов" />
    {
      c.theses ? (
        <DocCard href={c.theses.pdf} title={c.theses.title ?? `Сборник тезисов ${c.year}`} />
      ) : (
        <p class="ob-empty">{NO_DATA}</p>
      )
    }
  </div>

  {
    c.posters.length > 0 && (
      <div class="ob-container ob-section">
        <SectionHeading title="Постеры" />
        {posterDocs.map((p) => (
          <DocCard href={p.url} title={p.title ?? `Постер конгресса ${c.year}`} />
        ))}
        {posterImages.length > 0 && (
          <div class="ob-pg">
            {posterImages.map((p) => {
              // Dimensions are known here (that is what `posterImages` filters
              // on), so no `inferSize` — it would make the build download every
              // poster just to learn what the content model already states.
              const size = displaySize(p.width, p.height, POSTER_MAX);
              return (
                <Image
                  src={mediaUrl(p.url)}
                  alt={p.title ?? `Постер конгресса ${c.year}`}
                  width={size.width}
                  height={size.height}
                  widths={POSTER_WIDTHS}
                  sizes="(min-width: 1024px) 300px, 92vw"
                  loading="lazy"
                  decoding="async"
                />
              );
            })}
          </div>
        )}
      </div>
    )
  }

  {
    partnerGroups.length > 0 && (
      <div class="ob-container ob-section">
        <SectionHeading title={`Партнёры конгресса ${c.year}`} />
        {partnerGroups.map((group) => (
          <PartnerTier tier={group.tier} label={group.label} partners={group.items} />
        ))}
      </div>
    )
  }
</BaseLayout>
