---
/**
 * DocCard — a downloadable document (program / theses PDF) hosted by US
 * (bundle components/archive/DocCard). The href goes through `mediaUrl()`; the
 * schema has already guaranteed the file is not a legacy cloud link.
 */
import { mediaUrl } from '@/config/site';
import NewTabHint from './NewTabHint.astro';

interface Props {
  href: string;
  title: string;
  meta?: string;
}

const { href, title, meta = 'PDF' } = Astro.props;
---

{/* New tab: the PDF lives on our S3 host, so following it in place would drop
    the reader out of the site and into a bare viewer with no way back. */}
<a class="ob-dc" href={mediaUrl(href)} target="_blank" rel="noopener">
  <span class="ob-dc__icon" aria-hidden="true">
    <svg
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5 2.5h7l3.5 3.5v11.5h-10.5z"></path>
      <path d="M12 2.5v3.5h3.5"></path>
      <path d="M7.5 11h5M7.5 14h5"></path>
    </svg>
  </span>
  <span>
    <span class="ob-dc__title">{title}</span>
    <span class="ob-dc__meta">{meta}</span>
  </span>
  {/* The sharpest case of Issue #37: the reader believes they are opening the
      program and arrives in a PDF viewer in a tab with no visible origin, so
      the card has to say where it is taking them before they follow it. */}
  <NewTabHint />
</a>
