#!/bin/sh
# Forced command for the CI deploy key on tools-prod-tw.
# Installed at /usr/local/bin/orthobio-deploy, referenced from the `deploy`
# user's authorized_keys as:
#
#   command="/usr/local/bin/orthobio-deploy",restrict ssh-ed25519 AAAA... orthobio-ci-deploy
#
# The `deploy` account has full sudo on this host — the security boundary for
# the CI key is THIS script, not the account. It admits exactly two things: an
# rsync confined to the hostname-neutral release directory, and the
# redirect-apply step. Anything else, including an interactive shell, is
# refused.
set -eu

DEPLOY_ROOT=/var/www/orthobio-site

case "${SSH_ORIGINAL_COMMAND:-}" in
    "rsync --server "*)
        # rrsync reads SSH_ORIGINAL_COMMAND itself and rejects any path that
        # escapes the directory it is given, so `../` in a client-supplied
        # path cannot reach the rest of the filesystem.
        exec /usr/bin/rrsync "$DEPLOY_ROOT"
        ;;
    "apply-redirects")
        exec sudo -n /usr/local/sbin/orthobio-apply-redirects
        ;;
    *)
        echo "orthobio-deploy: refused command: ${SSH_ORIGINAL_COMMAND:-<interactive shell>}" >&2
        exit 1
        ;;
esac
