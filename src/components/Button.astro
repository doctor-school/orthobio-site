---
/**
 * Button — renders <a> when `href` is set, else <button>.
 *
 * Design contract (bundle components/core/Button): at most ONE primary per page
 * (the «узнать первым» CTA); `ghost` + `arrow` is the standard «Посмотрите … →»
 * invitation link. Label comes from the default slot.
 */
import NewTabHint from './NewTabHint.astro';

type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  /** Appends the decorative «→» used by invitation links. */
  arrow?: boolean;
  /**
   * Opt-in new tab for a link that leaves the site. Explicit rather than sniffed
   * from the href: `mailto:`/`tel:` hand off to another app and must NOT get a
   * target, and the CTA URL is a config value that may be a bare host string.
   */
  external?: boolean;
  type?: 'button' | 'submit';
}

const {
  variant = 'primary',
  size = 'md',
  href,
  arrow = false,
  external = false,
  type = 'button',
} = Astro.props;
const cls = `ob-btn ob-btn--${variant} ob-btn--${size}`;
---

{
  href ? (
    <a class={cls} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
      <slot />
      {arrow && <span aria-hidden="true">→</span>}
      {/* Gated on the same flag that writes the `target`, so the two can never
          disagree — and after the arrow, which is `aria-hidden` and therefore
          not part of the name it is appended to. */}
      {external && <NewTabHint />}
    </a>
  ) : (
    <button class={cls} type={type}>
      <slot />
      {arrow && <span aria-hidden="true">→</span>}
    </button>
  )
}
