# build output
dist/
# generated types
.astro/
# dependencies
node_modules/
# logs
npm-debug.log*
pnpm-debug.log*
# environment variables
.env
.env.*
!.env.example
# Terraform state — contains live S3 keys; defence-in-depth on top of
# infra/terraform/.gitignore (which only protects once merged/checked out)
*.tfstate
*.tfstate.*
# OS / editor junk
.DS_Store
Thumbs.db
# Playwright MCP session artifacts
.playwright-mcp/
# Playwright test artifacts
test-results/
playwright-report/
# Asset-rescue staging (scripts/rescue-partner-logos.mjs) — rescued binaries
# live in the S3 bucket, never in git; regenerate the tree from the script.
.rescue/
