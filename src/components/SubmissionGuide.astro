---
/**
 * SubmissionGuide — «Как подать материалы» on /participants (Issue #99): the
 * owner-approved instruction for the congress cabinet, step by step, with the
 * cabinet's own screenshots where they illustrate.
 *
 * Built from the «Проживание» section (Accommodation.astro) rather than a new
 * visual language: the same landmark section with a fixed anchor, the same
 * card (`.ob-acc__way`) with a round tile and an h3 head, the same paragraph,
 * link, note and framed screenshot. Only the step stack, the lists, the
 * sub-headings and the UI-label mark are its own (`.ob-sub*`). No client JS.
 *
 * The tile carries the step number for the eye and is hidden from assistive
 * tech; the heading itself starts with the number, visually hidden, so the
 * outline reads «1. Кто может подать материалы» either way.
 *
 * A step's body is a sequence of small blocks (owner, 2026-10-08: «сплошная
 * простыня»), so the step reads as a how-to: short paragraphs, a numbered
 * list for actions in sequence, a bulleted one for facts, a sub-heading one
 * level under the step's, a callout note, screenshots where they belong and
 * — for «Частые вопросы» — the /faq accordion. Every sentence goes through
 * GuideText: link phrases become links, «…» cabinet names one inline style.
 *
 * A list item may carry a button (`cta`), the site Button in the
 * accommodation CTA placement (full width on a phone), `secondary` because the
 * page's one primary is the hotel booking; its label and URL are site config,
 * never copy. Its `note` (the «уже входили» line) sits muted right under it,
 * then the item's screenshots.
 *
 * Two of these blocks, one task per page (owner, 2026-10-07): «Как подать
 * материалы» on /participants (who may submit, sign-in) ends with a button to
 * /participants/zapolnit-zayavku, where «Как заполнить заявку» (the cabinet
 * steps, no sign-in) is the whole page — no heading of its own under the page
 * <h1>, and one intro line pointing back to the sign-in for whoever is not in
 * yet, its steps then <h2> (axe `heading-order`).
 */
import Button from '@/components/Button.astro';
import Faq from '@/components/Faq.astro';
import GuideText from '@/components/GuideText.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Shots from '@/components/SubmissionGuideShots.astro';
import { CABINET_LOGIN_LABEL, CABINET_LOGIN_URL } from '@/config/site';
import type { SubmissionGuideBlock } from '@/content';
import { guideStepId } from '@/lib/submission-guide';

interface Props {
  block: SubmissionGuideBlock;
}

const { block } = Astro.props;
const headingId = `${block.anchor}-title`;
// Steps sit one level under the guide's heading; with none, under the page <h1>.
const StepHeading = block.heading ? 'h3' : 'h2';
const SubHeading = block.heading ? 'h4' : 'h3';
const CTAS = { 'cabinet-login': { label: CABINET_LOGIN_LABEL, href: CABINET_LOGIN_URL } } as const;
const steps = block.steps.map((step, i) => ({
  ...step,
  n: i + 1,
  id: guideStepId(block.anchor, i + 1),
}));
---

<section class="ob-section ob-sub" id={block.anchor} aria-labelledby={block.heading ? headingId : undefined}>
  {block.heading && <SectionHeading title={block.heading} id={headingId} />}
  {
    block.intro && (
      <p class="ob-acc__p ob-sub__intro">
        <GuideText text={block.intro.text} links={block.intro.links} />
      </p>
    )
  }

  <div class="ob-sub__steps">
    {
      steps.map((step) => (
        <article class="ob-acc__way" id={step.id} aria-labelledby={`${step.id}-title`}>
          <div class="ob-acc__wayhead">
            <span class="ob-acc__ico ob-sub__num" aria-hidden="true">
              {step.n}
            </span>
            <StepHeading class="ob-acc__wayt" id={`${step.id}-title`}><span class="ob-sr-only">{`${step.n}. `}</span>{step.title}</StepHeading>
          </div>
          {step.body.map((part) =>
            part.kind === 'paragraph' ? (
              <p class="ob-acc__p">
                <GuideText text={part.text} links={part.links} />
              </p>
            ) : part.kind === 'subheading' ? (
              <SubHeading class="ob-sub__subhead">{part.text}</SubHeading>
            ) : part.kind === 'steps' || part.kind === 'bullets' ? (
              (() => {
                const List = part.kind === 'steps' ? 'ol' : 'ul';
                return (
                  <List class="ob-list ob-sub__items">
                    {part.items.map((item) => {
                      const cta = item.cta === null ? null : CTAS[item.cta];
                      return (
                        <li>
                          <GuideText text={item.text} links={item.links} />
                          {cta && (
                            <Button class="ob-acc__cta ob-sub__cta" variant="secondary" size="lg" href={cta.href} external>
                              {cta.label}
                            </Button>
                          )}
                          {item.note && <p class="ob-sub__hint">{item.note}</p>}
                          {item.shots.length > 0 && <Shots shots={item.shots} />}
                        </li>
                      );
                    })}
                  </List>
                );
              })()
            ) : part.kind === 'note' ? (
              <div class="ob-acc__note ob-sub__callout">
                <div>
                  {part.paragraphs.map((text, i) => (
                    <p>
                      {i === 0 && part.lead && <em>{part.lead} </em>}
                      <GuideText text={text} />
                    </p>
                  ))}
                </div>
              </div>
            ) : part.kind === 'shots' ? (
              <Shots shots={part.shots} />
            ) : (
              <Faq items={part.items} uiLabels />
            ),
          )}
        </article>
      ))
    }
  </div>
  {
    block.next && (
      <p class="ob-sub__next">
        <Button variant="secondary" arrow href={block.next.href}>
          {block.next.text}
        </Button>
      </p>
    )
  }
</section>
