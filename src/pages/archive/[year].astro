---
/**
 * Archive year page — MINIMAL data-model smoke template (Issue #1).
 *
 * Deliberately unstyled semantic HTML: it exists only to prove that a congress
 * year edition renders from YAML without touching the template. Visual design
 * is a later separate stage (Issue #4 + Claude.design) — do not add styling
 * here.
 *
 * Nullability rendering follows AGENTS.md content integrity: unknown facts
 * show an explicit «нет данных», never an invented value.
 */
import { getCongressYears, PARTNER_TIERS, PARTNER_TIER_LABELS } from '@/content';
import type { CongressEntry } from '@/content';

export async function getStaticPaths() {
  const years = await getCongressYears();
  // Drafts (fixtures) are still built at this stage so the smoke page exists;
  // prod filtering of drafts arrives with the real pages (Issue #4).
  return years.map((entry) => {
    if (String(entry.data.year) !== entry.id) {
      throw new Error(
        `congress/${entry.id}.yaml declares year=${entry.data.year} — filename and year must match`,
      );
    }
    return { params: { year: entry.id }, props: { entry } };
  });
}

interface Props {
  entry: CongressEntry;
}

const { entry } = Astro.props;
const c = entry.data;

const NO_DATA = 'нет данных';

// Group partners by tier, preserving the canonical tier order.
const partnerGroups = PARTNER_TIERS.map((tier) => ({
  tier,
  label: PARTNER_TIER_LABELS[tier],
  items: c.partners.filter((p) => p.tier === tier),
})).filter((g) => g.items.length > 0);

const pageTitle = `${c.title ?? `Конгресс ОРТОБИОЛОГИЯ`} — ${c.year} — архив`;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {c.draft && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
  </head>
  <body>
    {c.draft && <p><strong>ЧЕРНОВИК / ФИКСТУРА — не публиковать</strong></p>}

    <header>
      <h1>{c.title ?? NO_DATA}</h1>
      <dl>
        <dt>Год</dt>
        <dd>{c.year}</dd>
        <dt>№ конгресса</dt>
        <dd>{c.number ?? NO_DATA}</dd>
        <dt>Даты</dt>
        <dd>{c.dates ?? NO_DATA}</dd>
        <dt>Место</dt>
        <dd>{c.place ?? NO_DATA}</dd>
      </dl>
    </header>

    <section aria-labelledby="greetings-h">
      <h2 id="greetings-h">Президиум и обращения</h2>
      {c.greetings.length === 0 && <p>{NO_DATA}</p>}
      {
        c.greetings.map((g) => (
          <article>
            <h3>{g.name}</h3>
            {g.role && <p>{g.role}</p>}
            {g.photo && <img src={g.photo} alt={`Фото: ${g.name}`} width="200" height="200" />}
            {g.text ? <blockquote>{g.text}</blockquote> : <p>Текст обращения: {NO_DATA}</p>}
          </article>
        ))
      }
    </section>

    <section aria-labelledby="committee-h">
      <h2 id="committee-h">Оргкомитет</h2>
      {c.committee.length === 0 && <p>{NO_DATA}</p>}
      {
        c.committee.length > 0 && (
          <ul>
            {c.committee.map((m) => (
              <li>
                {m.name}
                {m.regalia && ` — ${m.regalia}`}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section aria-labelledby="program-h">
      <h2 id="program-h">Программа</h2>
      {!c.program && <p>{NO_DATA}</p>}
      {c.program?.pdf && <p><a href={c.program.pdf}>Программа (PDF)</a></p>}
      {
        c.program && c.program.sessions.length > 0 && (
          <ol>
            {c.program.sessions.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>
                  {s.time ?? NO_DATA} · {s.hall ?? NO_DATA}
                </p>
                {s.moderators.length > 0 && <p>Модераторы: {s.moderators.join(', ')}</p>}
                {s.talks.length > 0 && (
                  <ul>
                    {s.talks.map((t) => (
                      <li>
                        {t.title}
                        {t.speakers.length > 0 && ` — ${t.speakers.join(', ')}`}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <section aria-labelledby="photos-h">
      <h2 id="photos-h">Фотогалерея</h2>
      {c.photos.length === 0 && <p>{NO_DATA}</p>}
      {
        c.photos.length > 0 && (
          <ul>
            {c.photos.map((p) => (
              <li>
                <img
                  src={p.url}
                  alt={p.alt ?? `Фото конгресса ${c.year}`}
                  loading="lazy"
                  width="400"
                  height="300"
                />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section aria-labelledby="videos-h">
      <h2 id="videos-h">Видеоотчёт</h2>
      {c.videos.length === 0 && <p>{NO_DATA}</p>}
      {
        c.videos.length > 0 && (
          <ul>
            {c.videos.map((v) => (
              <li>
                <a href={v.url}>{v.title ?? `Видео конгресса ${c.year}`}</a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section aria-labelledby="theses-h">
      <h2 id="theses-h">Сборник тезисов</h2>
      {
        c.theses ? (
          <p>
            <a href={c.theses.pdf}>{c.theses.title ?? `Сборник тезисов ${c.year} (PDF)`}</a>
          </p>
        ) : (
          <p>{NO_DATA}</p>
        )
      }
    </section>

    <section aria-labelledby="partners-h">
      <h2 id="partners-h">Партнёры и организаторы</h2>
      {partnerGroups.length === 0 && <p>{NO_DATA}</p>}
      {
        partnerGroups.map((group) => (
          <section>
            <h3>{group.label}</h3>
            <ul>
              {group.items.map((p) => (
                <li>
                  {p.logo && <img src={p.logo} alt={`Логотип: ${p.name}`} width="120" height="60" />}
                  {p.url ? <a href={p.url}>{p.name}</a> : p.name}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </body>
</html>
