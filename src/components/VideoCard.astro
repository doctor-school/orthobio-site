---
/**
 * VideoCard — видеоотчёт года: click-to-load фасад (design brief §3.5).
 *
 * The card never ships a player up front: a year holds up to eight videos and
 * eight provider frames on one page is a minute of loading on a clinic
 * connection. The facade is the design's plate — host badge + play glyph — and
 * the provider frame arrives only on click.
 *
 * The plate is backed by the video's own poster frame (Issue #33). It is OUR
 * copy of that frame: the 23 archive posters were fetched once and re-encoded
 * into `posters/` in the Timeweb bucket (`scripts/rescue-video-posters.mjs`),
 * so the card still asks no foreign CDN for a pixel — hotlinking `i.ytimg.com`
 * is what the media rule forbids, not showing a thumbnail. A video whose
 * provider publishes no frame keeps the bare dark plate, which is a finished
 * state and not a defect.
 *
 * Every card is a LINK first. A Rutube card additionally carries
 * `data-ob-video` and is upgraded by the island below: a plain left-click swaps
 * the player in instead of navigating. Everything the anchor gives stays
 * intact — Ctrl-, ⌘- and middle-click open the video on Rutube, «копировать
 * адрес ссылки» yields a URL a colleague can be sent, and with no JS at all (a
 * proxy that strips `type="module"`, an extension, a future `script-src
 * 'self'`) the card still goes where it says it goes. The island upgrades the
 * link; it never replaces it.
 *
 * Both hosts get `target="_blank" rel="noopener noreferrer"`, Rutube included:
 * the site-wide rule is that a third-party host never takes over the tab the
 * reader is in (PR #29), and it applies to the fallback path just as much. With
 * the island running the attribute is inert — the click is intercepted before
 * the browser acts on it.
 *
 * YouTube cards are not upgraded at all: 20 of the 23 archive videos live there
 * and the RF cannot rely on that player loading, so the card says out loud that
 * it leaves the site instead of embedding a frame that may never paint.
 */
import { mediaUrl } from '@/config/site';
import { videoHost } from '@/lib/congress';
import { videoEmbedSrc } from '@/lib/video';
import NewTabHint from './NewTabHint.astro';

interface Props {
  url: string;
  title?: string | null;
  year: number;
  /** Poster frame on OUR storage; null → the facade keeps the dark plate. */
  poster?: { url: string; width: number; height: number } | null;
}

const { url, title = null, year, poster = null } = Astro.props;
const host = videoHost(url);
const label = title ?? `Видео конгресса ${year}`;
const embedSrc = videoEmbedSrc(url);
---

{/* The video host is a third party — open it beside the site, never in place
    (#29). No `aria-label`: the accessible name is the card's own text — host
    badge plus caption — which is every visible string inside the control, so a
    speech-input user can say «Rutube» or the title and hit the same target
    (WCAG 2.5.3). An authored label would also have to promise something
    conditional: «смотреть на странице» is false for exactly the no-JS visitor
    the anchor exists to serve. */}
<a
  class="ob-vc"
  href={url}
  data-ob-video={embedSrc ?? undefined}
  data-ob-video-title={embedSrc ? label : undefined}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="ob-vc__facade">
    {/* `alt=""`: the frame carries no information the card does not already
        state in text, and an alt here would be read out ahead of the caption
        that actually names the video. Explicit width/height are the intrinsic
        size of the object in the bucket — the box is already reserved by the
        facade's 16/9, and these keep it reserved correctly if the CSS has not
        arrived yet. */}
    {
      poster && (
        <img
          class="ob-vc__poster"
          src={mediaUrl(poster.url)}
          alt=""
          width={poster.width}
          height={poster.height}
          loading="lazy"
          decoding="async"
        />
      )
    }
    <span class="ob-vc__host">{host}</span>
    <span class="ob-vc__play">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5.5v13l11-6.5z" />
      </svg>
    </span>
  </span>
  <span class="ob-vc__title">{label}</span>
  {/* The new-tab announcement (Issue #37) is CONDITIONAL here, where every
      other link component states it unconditionally, because this is the only
      card whose behaviour an island rewrites.

      • Embeddable (Rutube): the markup promises a tab and so does the hint —
        that is the truth with no JS, which is the state this anchor exists to
        serve. The island retracts it below the moment it takes the click over.
      • Not embeddable (YouTube): `.ob-vc__ext` already says «Откроется на
        YouTube в новой вкладке» in VISIBLE copy, which is part of the
        accessible name. A hidden suffix on top would read the promise twice. */}
  {embedSrc && <NewTabHint />}
  {
    !embedSrc && (
      <span class="ob-vc__ext">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3zM5 5h5v2H6v11h11v-4h2v6H5V5z" />
        </svg>
        Откроется на {host} в новой вкладке
      </span>
    )
  }
</a>

<script>
  /**
   * Click-to-load: upgrade a plain left-click on an embeddable card into an
   * in-page player. Every click that means «somewhere else, please» — modified,
   * middle, context menu — is left to the browser, so the anchor keeps behaving
   * like an anchor.
   *
   * Delegated once per page rather than per card: a year page carries up to
   * eight of these. Astro 6 renders this import-less component script INLINE
   * into every page that uses the component (~0.4 KB apiece, not a shared
   * bundle), which is why the eleven pages without a VideoCard ship zero JS —
   * but an inline module cannot run under `script-src 'self'`. If that directive
   * is ever added to either nginx vhost, this island needs a hash or a
   * real file, and the e2e suite — which runs against `astro preview`, with no
   * such headers — will stay green while click-to-load dies in production. The
   * anchor underneath is what keeps that failure survivable.
   */

  /**
   * THE predicate: the player URL this island will swap in for a card, or
   * `null` when it will leave the card alone.
   *
   * One function because two callers must never disagree. The click handler
   * intercepts on the value's SHAPE — the listener is document-level and an
   * iframe `src` is one of the few sinks where a `javascript:` URL would run in
   * our own origin, so it trusts what it can verify rather than the fact that
   * this file wrote the attribute. The announcement retracted below has to be
   * retracted under exactly that condition and no other. Asking `a[data-ob-video]`
   * there instead would be the same answer only for as long as Rutube is the
   * only embeddable host: add a second one to `videoEmbedSrc` and every card of
   * it would go silent about a tab this handler still lets the browser open —
   * a gap the e2e sweep cannot see, because the sweep runs with JS off.
   */
  const playerSrc = (link: HTMLAnchorElement): string | null => {
    const src = link.dataset.obVideo;
    return src?.startsWith('https://rutube.ru/play/embed/') ? src : null;
  };

  /**
   * Retract the new-tab announcement the markup ships (Issue #37): from the
   * moment this file runs, a plain click on an upgraded card loads the player
   * in place and opens nothing. Done here rather than by omitting the hint at
   * build time, because THIS is the event that makes it false — if the module
   * never executes, the card really does open a tab and the reader is still
   * told. The `target` attribute stays: it is what a modified or middle click
   * still uses, and those are announced by the browser's own affordances.
   */
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-ob-video]')) {
    if (playerSrc(link)) link.querySelector('.ob-sr-only')?.remove();
  }

  document.addEventListener('click', (event) => {
    // Let the browser own every click that means «somewhere else, please».
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return;
    }
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>('a[data-ob-video]');
    const src = link && playerSrc(link);
    if (!src) return;
    event.preventDefault();

    const frame = document.createElement('iframe');
    frame.className = 'ob-vc__frame';
    frame.src = src;
    frame.title = link.dataset.obVideoTitle ?? 'Видеозапись конгресса';
    // `fullscreen` rides in `allow`; adding the legacy `allowfullscreen`
    // attribute next to it only earns a console warning about which one wins.
    frame.allow = 'clipboard-write; autoplay; encrypted-media; fullscreen; picture-in-picture';

    // An <a> cannot stay wrapped around the player, so the card is rebuilt as a
    // plain container; the caption element is moved across, not re-rendered.
    const card = document.createElement('div');
    card.className = link.className;
    const caption = link.querySelector('.ob-vc__title');
    card.append(frame);
    if (caption) card.append(caption);
    link.replaceWith(card);

    // Focus followed the click into an element that no longer exists; without
    // this a keyboard user restarts at the top of the document.
    frame.focus();
  });
</script>
