---
/**
 * Главная (/) — ТЗ §4: hero 2027, цифры прошлых лет, CTA регистрации,
 * честная заглушка программы и тизер архива.
 *
 * The program placeholder is READ FROM the /program page entry, so the honest
 * «в разработке» wording exists in exactly one place.
 */
import ArchiveYearCard from '@/components/ArchiveYearCard.astro';
import Button from '@/components/Button.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Stat from '@/components/Stat.astro';
import Stub from '@/components/Stub.astro';
import {
  REGISTRATION_CTA_LABEL,
  REGISTRATION_OPENS,
  REGISTRATION_URL,
  UPCOMING_CONGRESS_DATES,
  UPCOMING_CONGRESS_VENUE,
} from '@/config/site';
import { getCongressYears, getPage } from '@/content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const { data: page } = await getPage('home');
const { data: programPage } = await getPage('program');
const programStub = programPage.blocks.find((b) => b.kind === 'stub');

// Teaser: the three most recent congresses; the hub has them all.
const recentYears = (await getCongressYears()).slice(0, 3);

---

<BaseLayout title={page.title} description={page.description}>
  <Hero
    overline={page.overline}
    title={page.title}
    dates={UPCOMING_CONGRESS_DATES.display}
    venue={UPCOMING_CONGRESS_VENUE.display}
  >
    {page.lead.map((p) => <p>{p}</p>)}

    {/* Issue #78: the primary CTA leads to the on-site form. The opening
        sentence stays beside it — before 1 October the form page shows the
        same «откроется» state, and the reader should not have to click to
        learn it. */}
    <div slot="cta" class="ob-hero__cta">
      <Button size="lg" href={REGISTRATION_URL}>
        {REGISTRATION_CTA_LABEL}
      </Button>
      <p class="ob-hero__cta-when">Регистрация откроется {REGISTRATION_OPENS.display} года</p>
    </div>

    <Fragment slot="stats">
      {page.stats.map((s) => <Stat value={s.value} label={s.label} />)}
    </Fragment>

    {page.statsNote && <p class="ob-hero__cta-note" slot="statsNote">{page.statsNote}</p>}
  </Hero>

  {
    programStub && (
      <div class="ob-container ob-section">
        <SectionHeading
          overline="2027"
          title="Программа конгресса"
          linkLabel="О программе"
          linkHref="/program"
        />
        <Stub
          compact
          icon="calendar"
          level="h3"
          title={programStub.title}
          text={programStub.text}
          linkLabel={programStub.linkLabel}
          linkHref={programStub.linkHref}
        />
      </div>
    )
  }

  <div class="ob-band">
    <div class="ob-container ob-section">
      <SectionHeading
        overline="2021-2026"
        title="Архив конгрессов"
        linkLabel="Все годы"
        linkHref="/archive/"
      />
      <div class="ob-cards">
        {recentYears.map((entry) => <ArchiveYearCard entry={entry} />)}
      </div>
    </div>
  </div>
</BaseLayout>
